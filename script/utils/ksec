#!/bin/bash
# ksec: 比對與輪替 k8s deployment 讀取的 secret（源頭為 GCP Secret Manager 同名 dotenv）。
# 只顯示 key 名稱與長度，不印出值。新值從 stdin 讀取，例如 pbpaste | ksec rotate ...。
#
#   ksec keys   <deploy>          列出 deploy 讀的 secret，比對 k8s / SM / 參考 secret 的 key
#   <來源> | ksec rotate <deploy> <KEY>   把 stdin 的值寫進 SM 新版本 → patch k8s 單一 key → restart → 驗證
#
# 預設用目前的 kubectl context 與 namespace（用 k8s ctx / k8s ns 切換）；可用 CTX、NS 臨時覆蓋。
# 其他環境變數：SM（SM secret 名稱，預設同 k8s secret）、PROJECT（production-1386）、
#           REF（比對用的參考 SM secret，預設 pms-production-secrets；設空字串則不比對）
set -euo pipefail

CTX="${CTX:-$(kubectl config current-context)}"
NS="${NS:-$(kubectl config view --minify -o jsonpath='{..namespace}')}"
NS="${NS:-default}"
PROJECT="${PROJECT:-production-1386}"
REF="${REF-pms-production-secrets}"

die() { printf '\033[1;31m%s\033[0m\n' "$*" >&2; exit 1; }
kc() { kubectl --context "$CTX" -n "$NS" "$@"; }
sm_get() { gcloud secrets versions access latest --secret "$1" --project "$PROJECT"; }
sm_has() { gcloud secrets describe "$1" --project "$PROJECT" >/dev/null 2>&1; }
env_keys() { grep -E '^[A-Za-z_][A-Za-z0-9_]*=' | cut -d= -f1 | sort -u; }

secrets_of() {
  kc get deploy "$1" -o jsonpath='{range .spec.template.spec.containers[*].envFrom[*]}{.secretRef.name}{"\n"}{end}' |
    grep -v '^$' | sort -u
}

users_of() {
  kc get deploy -o go-template='{{range .items}}{{$n := .metadata.name}}{{range .spec.template.spec.containers}}{{range .envFrom}}{{if .secretRef}}{{$n}} {{.secretRef.name}}{{"\n"}}{{end}}{{end}}{{end}}{{end}}' |
    awk -v s="$1" '$2==s{print $1}' | sort -u
}

k8s_keys() {
  kc get secret "$1" -o go-template='{{range $k,$v := .data}}{{$k}}{{"\n"}}{{end}}' | sort -u
}

cmd_keys() {
  local deploy="$1" s tmp
  tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
  [ -n "$REF" ] && sm_get "$REF" | env_keys >"$tmp/ref"
  for s in $(secrets_of "$deploy"); do
    printf '\n\033[1;36m%s\033[0m' "$s"
    k8s_keys "$s" >"$tmp/k8s"
    if sm_has "${SM:-$s}"; then sm_get "${SM:-$s}" | env_keys >"$tmp/sm"; echo "  (SM: $PROJECT/${SM:-$s})"
    else : >"$tmp/sm"; echo "  (SM 無同名 secret)"; fi
    [ -n "$REF" ] || : >"$tmp/ref"
    printf '%-40s k8s  SM   %s\n' KEY "${REF:-ref}"
    sort -u "$tmp/k8s" "$tmp/sm" "$tmp/ref" | while read -r k; do
      printf '%-40s %s    %s    %s\n' "$k" \
        "$(grep -qx "$k" "$tmp/k8s" && echo ✓ || echo ·)" \
        "$(grep -qx "$k" "$tmp/sm" && echo ✓ || echo ·)" \
        "$(grep -qx "$k" "$tmp/ref" && echo ✓ || echo ·)"
    done
  done
}

cmd_rotate() {
  local deploy="$1" key="$2" s val ans
  [[ "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "KEY 格式不對：$key"
  [ -t 0 ] && die "請把新值用 pipe 餵進來，例如：pbpaste | ksec rotate $deploy $key"
  val="$(cat)"
  [ -n "$val" ] || die "stdin 是空的"
  [[ "$val" != *$'\n'* ]] || die "新值中間有換行，dotenv 放不下，請先處理"
  set -- $(secrets_of "$deploy")
  [ $# -eq 1 ] || die "$deploy 讀了 $# 個 secret（$*），請用 SECRET=<name> 指定"
  s="${SECRET:-$1}"
  local sm="${SM:-$s}" users d
  sm_has "$sm" || die "SM 沒有 $PROJECT/${sm}；名稱不同時用 SM=<name> 指定"
  users="$(users_of "$s")"
  printf '\033[1;33m目標：%s / %s\033[0m\n  secret/%s ← SM %s/%s\n  key %s（%s，新值長度 %s）\n  會重啟：%s\n' \
    "$CTX" "$NS" "$s" "$PROJECT" "$sm" "$key" \
    "$(sm_get "$sm" | grep -q "^$key=" && echo 取代既有值 || echo 新增)" "${#val}" "$(echo $users)"
  read -r -p "確定？[y/N] " ans </dev/tty
  [ "$ans" = y ] || die "已取消，沒有任何變動"

  echo "1/4 寫入 SM 新版本"
  { sm_get "$sm" | grep -v "^$key="; printf '%s=%s\n' "$key" "$val"; } |
    gcloud secrets versions add "$sm" --project "$PROJECT" --data-file=- --format='value(name)' | sed 's|.*/|   SM version |'

  # 只 patch 這個 key：k8s secret 可能有不在 SM dotenv 的 key（如 PASSPORT_*），整份 apply 會刪掉它們
  echo "2/4 patch k8s secret 的 $key"
  printf '{"data":{"%s":"%s"}}' "$key" "$(printf '%s' "$val" | base64 | tr -d '\n')" |
    kc patch secret "$s" --type merge --patch-file /dev/stdin

  echo "3/4 restart 所有讀這份 secret 的 deploy"
  for d in $users; do kc rollout restart "deploy/$d" >/dev/null; done
  for d in $users; do
    [ "$(kc get deploy "$d" -o jsonpath='{.spec.replicas}')" = 0 ] && { echo "   $d replicas=0，略過"; continue; }
    kc rollout status "deploy/$d" --timeout=600s
  done
  if [ "$(kc get deploy "$deploy" -o jsonpath='{.spec.replicas}')" = 0 ]; then
    echo "   $deploy replicas=0，沒有 pod 可驗證；scale up 後會吃到新值"; return
  fi

  echo "4/4 驗證 pod 內的值"
  if [ "$(kc exec "deploy/$deploy" -- printenv "$key" 2>/dev/null)" = "$val" ]; then
    printf '\033[1;32m   pod 的 %s 與輸入值一致\033[0m\n' "$key"
  else
    die "   pod 的 $key 與輸入值不一致"
  fi
}

case "${1:-}" in
  keys)   [ $# -eq 2 ] || die "用法：ksec keys <deploy>"; cmd_keys "$2" ;;
  rotate) [ $# -eq 3 ] || die "用法：pbpaste | ksec rotate <deploy> <KEY>"; cmd_rotate "$2" "$3" ;;
  *) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
