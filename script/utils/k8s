#!/bin/bash
# k8s: kubectl 常用操作的短指令，一律套用目前的 context / namespace。
# 沒帶名稱的地方用 fzf 挑；不認得的子指令原樣交給 kubectl（k8s get svc = kubectl get svc）。
# 只顯示 secret 的 key 名稱與長度，不印值。
#
#   k8s                      顯示目前 context / namespace 與這份說明（k8s help 只看說明）
#   k8s ctx [name|-]         切 context（kubectx）
#   k8s ns  [name|-]         切 namespace（kubens）
#   k8s pods [filter]        列 pod（可用字串過濾）
#   k8s logs [deploy|pod]    追 log（-f，最近 200 行；多 container 時用 fzf 挑）
#   k8s sh   [deploy|pod]    進 container 開 shell
#   k8s restart [deploy]     rollout restart 並等待完成
#   k8s env  [deploy]        列出 deploy 讀的 configmap / secret 與 key 名稱
#   k8s keys [deploy]        比對 secret 的 key：k8s / Secret Manager / 正式站
#   <來源> | k8s rotate <deploy> <KEY>
#                            stdin 的值 → SM 新版本 → patch k8s 單一 key → 重啟讀這份 secret 的 deploy → 驗證
#   k8s hist [deploy]        歷史：rollout 版本、最近事件、ArgoCD git 紀錄、SM 版本
#   k8s cm [configmap]       改 configmap：ArgoCD 管的就開 repo 原始檔 → commit / push；其餘 kubectl edit
#
# CTX、NS：臨時指定 context / namespace（不設就用目前的）。
# Secret Manager：SM（名稱，預設同 k8s secret；正式站要 SM=pms-production-secrets）、
#                 PROJECT（預設 production-1386）、REF（keys 的比對基準，預設 pms-production-secrets）
#
# 範例：
#   k8s ctx prod && k8s ns production
#   k8s hist pms
#   pbpaste | SM=pms-production-secrets k8s rotate pms PRE_CHECKIN_PASSWORD
#   CTX=test NS=testing k8s keys pms-testing-qa1
# 介面版：k9s（Shift-2 deploy 樹、Shift-H 歷史、Shift-W 改 secret、Shift-E 改 configmap、? 看全部）
set -euo pipefail

PROJECT="${PROJECT:-production-1386}"
REF="${REF-pms-production-secrets}"

die() { printf '\033[1;31m%s\033[0m\n' "$*" >&2; exit 1; }
usage() { sed -n '2,/^set -euo/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'; }
# CTX / NS 有設就覆蓋目前的 context / namespace（k9s 外掛會帶進來）
kubectl() { command kubectl ${CTX:+--context "$CTX"} ${NS:+--namespace "$NS"} "$@"; }
ctx() { [ -n "${CTX:-}" ] && { echo "$CTX"; return; }; kubectl config current-context; }
ns() { [ -n "${NS:-}" ] && { echo "$NS"; return; }; local n; n="$(kubectl config view --minify -o jsonpath='{..namespace}')"; echo "${n:-default}"; }
sm_get() { gcloud secrets versions access latest --secret "$1" --project "$PROJECT"; }
sm_has() { gcloud secrets describe "$1" --project "$PROJECT" >/dev/null 2>&1; }
env_keys() { grep -E '^[A-Za-z_][A-Za-z0-9_]*=' | cut -d= -f1 | sort -u; }
yes_or_die() { read -r -p "確定？[y/N] " a </dev/tty; [ "$a" = y ] || die "已取消，沒有任何變動"; }

pick() { # pick <kind> [preset]：有給名稱就用，沒給就 fzf
  [ -n "${2:-}" ] && { echo "$2"; return; }
  command -v fzf >/dev/null || die "請給 $1 名稱（沒有 fzf 可挑）"
  kubectl get "$1" -o name | sed 's|^.*/||' | fzf --prompt="$1 ($(ctx)/$(ns))> " || die "已取消"
}

target() { # 名稱是 deploy 就用 deploy/<name>，否則當 pod
  local name; name="$(pick "${1:-pods}" "${2:-}")"
  if kubectl get deploy "$name" >/dev/null 2>&1; then echo "deploy/$name"; else echo "pod/$name"; fi
}

container_of() { # 多個 container 時用 fzf 挑
  local cs
  cs="$(kubectl get "$1" -o jsonpath='{.spec.template.spec.containers[*].name}{.spec.containers[*].name}' | tr ' ' '\n' | grep -v '^$')"
  [ "$(echo "$cs" | wc -l)" -le 1 ] && { echo "$cs"; return; }
  echo "$cs" | fzf --prompt="container> " || die "已取消"
}

secrets_of() { # deploy 用 envFrom 讀的 secret
  kubectl get deploy "$1" -o jsonpath='{range .spec.template.spec.containers[*].envFrom[*]}{.secretRef.name}{"\n"}{end}' | grep -v '^$' | sort -u
}

users_of() { # 用 envFrom 讀這份 secret 的所有 deploy
  kubectl get deploy -o go-template='{{range .items}}{{$n := .metadata.name}}{{range .spec.template.spec.containers}}{{range .envFrom}}{{if .secretRef}}{{$n}} {{.secretRef.name}}{{"\n"}}{{end}}{{end}}{{end}}{{end}}' |
    awk -v s="$1" '$2==s{print $1}' | sort -u
}

secret_keys() { kubectl get secret "$1" -o go-template='{{range $k,$v := .data}}{{$k}}{{"\n"}}{{end}}' | sort -u; }

cmd_keys() {
  local d s sm tmp k
  d="$(pick deploy "${1:-}")"
  tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
  if [ -n "$REF" ]; then sm_get "$REF" | env_keys >"$tmp/ref"; else : >"$tmp/ref"; fi
  for s in $(secrets_of "$d"); do
    sm="${SM:-$s}"
    secret_keys "$s" >"$tmp/k8s"
    if sm_has "$sm"; then sm_get "$sm" | env_keys >"$tmp/sm"; printf '\033[1;36msecret/%s\033[0m  (SM %s)\n' "$s" "$sm"
    else : >"$tmp/sm"; printf '\033[1;36msecret/%s\033[0m  (SM 沒有 %s，名稱不同時用 SM=<name>)\n' "$s" "$sm"; fi
    printf '%-40s k8s  SM   %s\n' KEY "${REF:-ref}"
    sort -u "$tmp/k8s" "$tmp/sm" "$tmp/ref" | while read -r k; do
      printf '%-40s %s    %s    %s\n' "$k" \
        "$(grep -qx "$k" "$tmp/k8s" && echo ✓ || echo ·)" \
        "$(grep -qx "$k" "$tmp/sm" && echo ✓ || echo ·)" \
        "$(grep -qx "$k" "$tmp/ref" && echo ✓ || echo ·)"
    done
  done
}

cmd_rotate() {
  local d="$1" key="$2" s sm val users u
  [[ "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "KEY 格式不對：$key"
  [ -t 0 ] && die "請把新值用 pipe 餵進來，例如：pbpaste | k8s rotate $d $key"
  val="$(cat)"
  [ -n "$val" ] || die "stdin 是空的"
  [[ "$val" != *$'\n'* ]] || die "新值中間有換行，dotenv 放不下"
  set -- $(secrets_of "$d")
  [ $# -eq 1 ] || die "$d 讀了 $# 個 secret（$*），請用 SECRET=<name> 指定"
  s="${SECRET:-$1}"; sm="${SM:-$s}"
  sm_has "$sm" || die "SM 沒有 $PROJECT/${sm}；名稱不同時用 SM=<name> 指定"
  users="$(users_of "$s")"
  printf '\033[1;33m目標：%s / %s\033[0m\n  secret/%s ← SM %s/%s\n  key %s（%s，新值長度 %s）\n  會重啟：%s\n' \
    "$(ctx)" "$(ns)" "$s" "$PROJECT" "$sm" "$key" \
    "$(sm_get "$sm" | grep -q "^$key=" && echo 取代既有值 || echo 新增)" "${#val}" "$(echo $users)"
  yes_or_die

  echo "1/4 寫入 SM 新版本"
  { sm_get "$sm" | grep -v "^$key="; printf '%s=%s\n' "$key" "$val"; } |
    gcloud secrets versions add "$sm" --project "$PROJECT" --data-file=- --format='value(name)' | sed 's|.*/|   SM version |'

  # 只 patch 這個 key：k8s secret 可能有不在 SM dotenv 的 key（如 PASSPORT_*），整份 apply 會刪掉它們
  echo "2/4 patch k8s secret 的 $key"
  printf '{"data":{"%s":"%s"}}' "$key" "$(printf '%s' "$val" | base64 | tr -d '\n')" |
    kubectl patch secret "$s" --type merge --patch-file /dev/stdin

  echo "3/4 重啟讀這份 secret 的 deploy"
  for u in $users; do kubectl rollout restart "deploy/$u" >/dev/null; done
  for u in $users; do
    [ "$(kubectl get deploy "$u" -o jsonpath='{.spec.replicas}')" = 0 ] && { echo "   $u replicas=0，略過"; continue; }
    kubectl rollout status "deploy/$u" --timeout=600s
  done
  [ "$(kubectl get deploy "$d" -o jsonpath='{.spec.replicas}')" = 0 ] && { echo "   $d replicas=0，沒有 pod 可驗證"; return; }

  echo "4/4 驗證 pod 內的值"
  [ "$(kubectl exec "deploy/$d" -- printenv "$key" 2>/dev/null)" = "$val" ] || die "   pod 的 $key 與輸入值不一致"
  printf '\033[1;32m   pod 的 %s 與輸入值一致\033[0m\n' "$key"
}

cmd_cm() {
  local c app repo file msg
  c="$(pick configmap "${1:-}")"
  app="$(kubectl get configmap "$c" -o jsonpath='{.metadata.labels.argocd\.argoproj\.io/instance}')"
  if [ -z "$app" ]; then kubectl edit configmap "$c"; return; fi
  repo="${ARGOCD_REPO:-$HOME/Project/Active/ITRD/devops/argocd}"
  [ -d "$repo/.git" ] || die "configmap/$c 由 ArgoCD app $app 管，但找不到 repo（設 ARGOCD_REPO）"
  git -C "$repo" pull -q --ff-only || die "repo 無法 fast-forward，先手動處理 $repo"
  file="$(grep -rlE "^  name: $c\$" "$repo/k8s-yaml" | xargs grep -lE "^  namespace: $(ns)\$" 2>/dev/null | head -20)"
  [ -n "$file" ] || die "repo 裡找不到 $(ns)/$c 的原始檔"
  [ "$(echo "$file" | wc -l)" -gt 1 ] && file="$(echo "$file" | fzf --prompt='原始檔> ')"
  printf '\033[1;33mconfigmap/%s 由 ArgoCD app %s 管，改原始檔：%s\033[0m\n' "$c" "$app" "${file#$repo/}"
  "${EDITOR:-vi}" "$file"
  git -C "$repo" diff --quiet -- "$file" && { echo "沒有變更"; return; }
  git -C "$repo" --no-pager diff --stat -- "$file"
  read -r -p "commit 訊息（空白取消）： " msg </dev/tty
  [ -n "$msg" ] || { echo "未 commit，變更留在 $repo"; return; }
  git -C "$repo" commit -q -m "$msg" -- "$file" && git -C "$repo" push -q && echo "已 push，ArgoCD 會自動 sync；subPath 掛載的 .env 要重啟 pod 才生效"
}

h() { printf '\n\033[1;36m== %s\033[0m\n' "$*"; }

cmd_hist() {
  local d sel app path repo s
  d="$(pick deploy "${1:-}")"
  sel="$(kubectl get deploy "$d" -o go-template='{{range $k,$v := .spec.selector.matchLabels}}{{$k}}={{$v}},{{end}}' | sed 's/,$//')"

  h "rollout 版本（新到舊）"
  kubectl get rs -l "$sel" --sort-by=.metadata.creationTimestamp \
    -o custom-columns='REV:.metadata.annotations.deployment\.kubernetes\.io/revision,CREATED:.metadata.creationTimestamp,READY:.status.readyReplicas,IMAGE:.spec.template.spec.containers[0].image' |
    awk 'NR==1{print; next} {a[++n]=$0} END{for(i=n;i>0&&i>n-10;i--) print a[i]}'

  h "最近事件（deploy、rs、pod）"
  kubectl get events --sort-by=.lastTimestamp \
    -o custom-columns='LAST:.lastTimestamp,TYPE:.type,REASON:.reason,OBJECT:.involvedObject.name,MESSAGE:.message' |
    awk -v d="$d" 'NR==1 || index($4,d)==1' | tail -20 | cut -c1-200

  app="$(kubectl get deploy "$d" -o jsonpath='{.metadata.labels.argocd\.argoproj\.io/instance}')"
  if [ -n "$app" ]; then
    path="$(command kubectl --context "${ARGOCD_CTX:-prod}" -n argocd get application "$app" -o jsonpath='{.spec.source.path}' 2>/dev/null || true)"
    repo="${ARGOCD_REPO:-$HOME/Project/Active/ITRD/devops/argocd}"
    h "ArgoCD app $app 的設定變更（${path:-找不到 path}）"
    if [ -n "$path" ] && [ -d "$repo/.git" ]; then
      git -C "$repo" fetch -q 2>/dev/null || true
      git -C "$repo" --no-pager log -10 --format='%ad  %<(14,trunc)%an %s' --date=format:'%m-%d %H:%M' origin/HEAD -- "$path"
    fi
  fi

  for s in $(secrets_of "$d"); do
    sm_has "${SM:-$s}" || continue
    h "SM ${SM:-$s} 版本（secret/$s 的源頭）"
    gcloud secrets versions list "${SM:-$s}" --project "$PROJECT" --limit 5 --format='table(name,state,createTime.date("%Y-%m-%d %H:%M"))'
  done
}

cmd="${1:-}"; shift || true
case "$cmd" in
  "")      printf '\033[1;33mcontext   %s\nnamespace %s\033[0m\n\n' "$(ctx)" "$(ns)"; usage ;;
  ctx)     kubectx "$@" ;;
  ns)      kubens "$@" ;;
  pods)    if [ -n "${1:-}" ]; then kubectl get pods -o wide | awk -v f="$1" 'NR==1 || index($0,f)'; else kubectl get pods -o wide; fi ;;
  logs)    t="$(target deploy "${1:-}")"; kubectl logs -f --tail=200 "$t" -c "$(container_of "$t")" ;;
  sh)      t="$(target deploy "${1:-}")"; c="$(container_of "$t")"
           kubectl exec -it "$t" -c "$c" -- sh -c 'command -v bash >/dev/null && exec bash || exec sh' ;;
  restart) d="$(pick deploy "${1:-}")"
           printf '\033[1;33m重啟 %s / %s deploy/%s\033[0m\n' "$(ctx)" "$(ns)" "$d"
           yes_or_die
           kubectl rollout restart "deploy/$d" && kubectl rollout status "deploy/$d" --timeout=300s ;;
  env)     d="$(pick deploy "${1:-}")"
           for r in $(kubectl get deploy "$d" -o jsonpath='{range .spec.template.spec.containers[*].envFrom[*]}{.configMapRef.name}{"\t"}{.secretRef.name}{"\n"}{end}{range .spec.template.spec.volumes[*]}{.configMap.name}{"\t"}{.secret.secretName}{"\n"}{end}' | awk -F'\t' '$1!=""{print "configmap/"$1} $2!=""{print "secret/"$2}' | sort -u); do
             printf '\033[1;36m%s\033[0m\n' "$r"
             kubectl get "$r" -o go-template='{{range $k,$v := .data}}  {{$k}}{{"\n"}}{{end}}'
           done ;;
  keys)    cmd_keys "${1:-}" ;;
  rotate)  [ $# -eq 2 ] || die "用法：pbpaste | k8s rotate <deploy> <KEY>"; cmd_rotate "$1" "$2" ;;
  cm)      cmd_cm "${1:-}" ;;
  hist)    cmd_hist "${1:-}" ;;
  help|-h|--help) usage ;;
  *)       kubectl "$cmd" "$@" ;;
esac
