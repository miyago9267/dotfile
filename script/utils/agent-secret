#!/bin/bash -p
# agent-secret：把單一 secret 注入單一指令的 broker。第一層依平台而定，第二層都是 sops + age：
#   macOS（Darwin）                                   Keychain -> sops
#   Windows（Git for Windows 的 bash，uname 為 MINGW* / MSYS*）  Credential Manager -> sops
#   其他平台（Linux 等）                              envfile -> sops
# macOS 與 Windows 的第一層合稱「本機儲存區」。下面寫「Keychain」的地方，在 Windows 上指的都是
# Credential Manager；envfile 只在 Linux 等其他平台使用，macOS 與 Windows 都不讀也不寫。
#
#   agent-secret run <name> -- <command> [args...]
#   agent-secret put <name>         從 stdin 讀值（在 terminal 直接跑會提示輸入）；macOS 寫 Keychain，
#                                   Windows 寫 Credential Manager，其他平台寫 envfile
#   agent-secret rm <NAME>          刪除簡易模式在本機儲存區（Keychain 或 Credential Manager）的項目；
#                                   其他平台不支援
#   agent-secret edit               以 sops 開啟 ~/dotfile/secrets/agent.enc.yaml
#   agent-secret list               兩種模式的名稱與各 backend 是否存在（不含值）。已登記的列另外顯示
#                                   注入的環境變數名稱（env=）與指令限制（cmds=* 或允許的絕對路徑）；
#                                   簡易模式的名稱本身就是環境變數名稱。欄位以 tab 分隔。
#                                   envfile 欄只讀 key 名稱；macOS 不碰 envfile，固定顯示 n/a；
#                                   Windows 的 keychain 欄改叫 wincred，沒有 envfile 欄。
#   agent-secret doctor             兩個 backend 都有的 alias、表與腳本的權限問題、簡易模式的數量
#
# 兩種模式，由名稱的寫法決定，不會重疊：
#   簡易模式（simple）    名稱是大寫環境變數寫法（^[A-Z][A-Z0-9_]*$），不需要登記。名稱本身就是注入的
#                         環境變數；put NAME 存進 Keychain（Windows 是 Credential Manager，其他平台是
#                         envfile），run NAME -- <指令> 取用。解析順序同 sops tier。
#                         方便，但取得值的指令沒有任何限制（不檢查 allowed_commands、不套拒絕清單，
#                         sh -c 也可以）：agent 技術上可以把值印出來。
#   已登記（registered）  名稱是小寫加 -（^[a-z0-9][a-z0-9-]*$），必須寫在 alias 表裡。
#                         allowed_commands 列出絕對路徑時強制比對；寫成 * 就沒有限制。
#                         production 或高權限的項目應該登記並列出明確路徑；真正的限制只來自這份清單。
# 兩種模式共用 Keychain 的 service agent-secret，靠 account 的大小寫分開。2026-10-05 以 dummy 項目
# 實測：Keychain 的 account 比對區分大小寫（大寫建立的項目用小寫查詢與刪除都回「找不到」，反向亦同，
# 兩個只差大小寫的 account 可以並存），所以 run / rm STRICT 不會碰到已登記的 strict。
# 表內第一欄若出現大寫名稱（不論該列是否合法），同名的簡易模式 run / put / rm 一律拒絕。
# Windows 的 Credential Manager 相反：target 名稱不分大小寫（2026-10-10 實測），所以兩種模式用不同的前綴
# 分開，簡易模式是 agent-secret/simple/<NAME>，已登記是 agent-secret/alias/<alias>；讀回來的 TargetName
# 還要與要求的名稱逐字（區分大小寫）相同，不同就當成錯誤。
# Miyago 2026-10-05 的決定：「我只想存進我的keychain然後讓agent可以調用而已，不就一個key name
# 一個value的事情嗎」。簡易模式的風險等級與既有的 ambient export 相同，但範圍縮到單一指令的執行期間。
#
# Alias 表固定在 <家目錄>/.config/agent-secret/aliases.tsv，格式 alias|tier|env_name|allowed_commands。
# 家目錄從帳號資料庫取得，不看 HOME；表、sops 檔與 age key 的路徑都由它推導，沒有任何環境變數開關。
#
# Tier：
#   keychain-only  只查本機儲存區（macOS：service agent-secret、account 為 alias；Windows：target
#                  agent-secret/alias/<alias>），永不查 sops；沒有本機儲存區的平台一律 fail closed。
#                  意義只有「值只存在這台機器的 login Keychain 或 Credential Manager，不進 repo、
#                  不同步到其他機器」；tier 的名稱在 Windows 上沿用。它不提供讀取時的確認。
#                  Windows：以同一個使用者執行的任何行程都能 CredRead，沒有逐項的 ACL。
#                  macOS：put 雖然以 -T "" 建立項目，但
#                  2026-10-05 實測不會跳確認視窗（無人看管下經 broker 讀取四次全部成功）。推測是項目由
#                  /usr/bin/security 建立、也由它讀取，被視為建立者自己存取（未驗證）。
#                  keychain-only 加 allowed_commands 為 * 等於沒有任何讀取限制。
#   sops           先查本機儲存區當本機 override；只有確認「找不到」才查 sops（macOS：security exit 44；
#                  Windows：exit code 3 加上 C# 印出的 sentinel，兩個訊號同時成立）。其他任何錯誤
#                  （上鎖、拒絕、-25308、PowerShell 起不來、解密失敗）都 fail closed，不落到下一層。
#                  Linux 等其他平台以 envfile 取代本機儲存區這一層：envfile 確認沒有這個 key 才查 sops。
#
# envfile（只有 macOS 與 Windows 以外的平台才用；Miyago 2026-11-07 決定工作站用 .env 的方式給值）：
#   <家目錄>/.config/agent-secret/secrets.env，一行一個 KEY=value，KEY 就是 alias（已登記的小寫 alias
#   或簡易模式的大寫名稱）。broker 不 source、不 eval：第一個 = 分開 key 與值，跳過空行與 # 開頭的行，
#   引號、空白與 $ 都原樣保留。檔案必須是目前使用者擁有、mode 剛好 600 的一般檔案（不是 symlink），
#   所在目錄也要是自己擁有且 group/other 不可寫；任一條不符、或同一個 key 出現兩次，都 fail closed。
#   put 以 umask 077 寫入：目錄 700、檔案 600，取代既有 key 時先寫同目錄的暫存檔再 mv。
#   macOS 與 Windows 永遠不讀也不寫 envfile。
#
# 指令限制一句話：有列出絕對路徑才有限制；* 與簡易模式都沒有限制。
#   - allowed_commands 是逗號分隔的絕對路徑時：只有清單內的路徑可以取用，而且 env / shell / 直譯器
#     即使列在清單內也拒絕（內建拒絕清單）。
#   - allowed_commands 是 * 時：不檢查指令，也不套內建拒絕清單（env、sh -c、npx 都可以）。那份清單
#     本來就擋不住包裝型或能讀環境的工具（caffeinate printenv、jq '$ENV.X'、
#     git -c alias.x='!printenv X'），保留只會造成「看起來有限制」的錯覺。
#   - Windows 的 allowed_commands 要寫 broker 解析出來的字串：MSYS 寫法的絕對路徑（/c/Users/...，不是
#     C:\...）、含 .exe、大小寫與呼叫時一致，例如 /c/Users/miyago/scoop/shims/gh.exe。呼叫時寫 gh、
#     gh.exe、C:\...\gh.exe 都會解析成這個字串。內建拒絕清單比對前會轉小寫並去掉結尾的 .exe。
#
# 對呼叫端環境的隔離：
#   - shebang 帶 -p（privileged）：不 source BASH_ENV、不匯入環境裡的函式；不是這個模式就拒絕執行。
#   - PATH 在開頭換成固定的系統路徑；呼叫端的 PATH 只在最後 exec 被允許的指令時還給它。
#   - locale 在開頭固定成 C（LC_ALL、LANG、LC_COLLATE、LC_CTYPE）：名稱的 [A-Z]、[a-z] 比對不隨
#     呼叫端的 collation 改變；呼叫端原本的值同樣只在最後 exec 時還原。
#   - 值只經過 stdin、pipe 與 export，不進任何行程的 argv；取得值之後只剩 export 與 exec 兩步。
#   - Windows：家目錄改問 cygpath -F 40（Win32 API），因為 Git for Windows 的 ~name 會跟著 HOME 走；
#     PowerShell 以 env -i 加固定的最小環境啟動，呼叫端的 PSModulePath、COR_*、COMPLUS_*、DOTNET_* 進不去。
# 已知限制：被允許的指令會繼承呼叫端的環境，包含 export -f 匯出的函式與直譯器的啟動變數
# （NODE_OPTIONS、PYTHONSTARTUP 這類）。上面的隔離只保護 broker 自己；allowed_commands 限制的是
# 「執行哪個程式」，不是「那個程式在什麼環境下跑」。被允許的指令如果是 bash 腳本，呼叫端匯出的
# 同名函式會在裡面執行並看得到注入的值。這屬於主動規避，不在威脅模型（合作型 agent 的意外外洩）內。
#
# 測試以 privileged shell source 本檔後覆寫 function（as_home、backend_keychain、backend_wincred、
# backend_sops、_security、_wincred、as_ps_bin、_sops）來 stub；backend_envfile 不 stub，直接讀寫
# 暫存家目錄裡的 envfile。

# --- 啟動檢查：必須在 privileged 模式，且關鍵名稱沒有被函式遮蔽 ---
case $- in
  *p*) ;;
  *)
    builtin printf '%s\n' "agent-secret: 拒絕執行：不在 bash privileged 模式（-p）。請直接執行 agent-secret 入口，不要用 bash <script> 或一般的 source。" >&2
    # shellcheck disable=SC2317
    return 1 2>/dev/null || exit 1
    ;;
esac
for AS_N in builtin command printf export exec declare unset read cd pwd type eval set shift local echo \
  cat od tr awk stat id uname readlink security sops mkdir mktemp chmod mv rm iconv base64 cygpath env; do
  if builtin declare -F "$AS_N" >/dev/null 2>&1; then
    builtin printf 'agent-secret: 拒絕執行：%s 被函式遮蔽\n' "$AS_N" >&2
    # shellcheck disable=SC2317
    return 1 2>/dev/null || exit 1
  fi
done
builtin unset AS_N

AS_CALLER_PATH=${PATH-}
PATH=/usr/bin:/bin:/usr/sbin:/sbin
# locale：記下呼叫端的值（有沒有設定也要記），自己固定用 C
AS_LC_SET=""
[[ -n ${LC_ALL+x} ]] && { AS_LC_SET="$AS_LC_SET LC_ALL"; AS_LC_ALL=$LC_ALL; }
[[ -n ${LANG+x} ]] && { AS_LC_SET="$AS_LC_SET LANG"; AS_LANG=$LANG; }
[[ -n ${LC_COLLATE+x} ]] && { AS_LC_SET="$AS_LC_SET LC_COLLATE"; AS_LC_COLLATE=$LC_COLLATE; }
[[ -n ${LC_CTYPE+x} ]] && { AS_LC_SET="$AS_LC_SET LC_CTYPE"; AS_LC_CTYPE=$LC_CTYPE; }
builtin export LC_ALL=C LANG=C LC_COLLATE=C LC_CTYPE=C
IFS=$' \t\n'
builtin unset CDPATH ENV BASH_ENV GLOBIGNORE AS_VALUE
set -uo pipefail

AS_SERVICE="agent-secret"
AS_ALIAS_RE='^[a-z0-9][a-z0-9-]*$'
AS_ENV_RE='^[A-Z][A-Z0-9_]*$'
# security -i 的行緩衝約 4096 bytes：超過會被截斷，截掉的部分還會被當成下一個指令印在錯誤訊息裡。
AS_MAX_VALUE_LEN=1024

die() { builtin printf 'agent-secret: %s\n' "$*" >&2; exit 1; }

# 家目錄：以目前帳號名稱做 ~name 展開（bash 走 getpwnam），不讀 HOME。macOS 與 Linux 通用。
# Git for Windows 例外：它的 /etc/nsswitch.conf 是 db_home: env ...，bash 由原生行程（PowerShell、
# Claude Code）啟動時 ~name 會跟著呼叫端的 HOME 走（2026-10-10 實測）。Windows 改問 cygpath -F 40
# （CSIDL_PROFILE，走 Win32 API）：實測 HOME、USERPROFILE、HOMEDRIVE、HOMEPATH 被改掉都不影響結果。
as_home() {
  local name home=""
  case "$(as_platform)" in
    MINGW*|MSYS*)
      home=$(cygpath -F 40) || return 1
      [[ $home == /* && -d $home ]] || return 1
      builtin printf '%s' "${home%/}"
      return 0
      ;;
  esac
  name=$(id -un) || return 1
  [[ $name =~ ^[A-Za-z_][A-Za-z0-9._-]*$ ]] || return 1
  builtin eval "home=~$name"
  [[ $home == /* && -d $home ]] || return 1
  builtin printf '%s' "${home%/}"
}

as_paths() {
  # 本機儲存區：Darwin 是 Keychain，Git for Windows 的 bash 是 Credential Manager，其餘沒有
  case "$(as_platform)" in
    Darwin) AS_STORE=keychain ;;
    MINGW*|MSYS*) AS_STORE=wincred ;;
    *) AS_STORE=none ;;
  esac
  # list / doctor 的欄位名稱與訊息裡的稱呼；沒有本機儲存區的平台沿用 keychain=n/a
  if [[ $AS_STORE == wincred ]]; then AS_STORE_COL=wincred; AS_STORE_LABEL="Credential Manager"
  else AS_STORE_COL=keychain; AS_STORE_LABEL="Keychain"; fi
  AS_HOME=$(as_home) || die "無法從帳號資料庫取得家目錄"
  [[ $AS_HOME == /* ]] || die "無法從帳號資料庫取得家目錄"
  AS_TABLE="$AS_HOME/.config/agent-secret/aliases.tsv"
  AS_SOPS_FILE="$AS_HOME/dotfile/secrets/agent.enc.yaml"
  AS_SOPS_CFG="$AS_HOME/dotfile/secrets/.sops.yaml"
  AS_AGE_KEY="$AS_HOME/.age/key.txt"
  AS_ENV_FILE="$AS_HOME/.config/agent-secret/secrets.env"
}

as_platform() { uname -s; }

# 目前平台的本機儲存區 backend（只在 AS_STORE 不是 none 時呼叫）
backend_store() { "backend_$AS_STORE" "$@"; }

# 把 locale 變數還原成呼叫端原本的樣子（只在 exec 前呼叫；只用賦值與 builtin）
as_restore_locale() {
  builtin unset LC_ALL LANG LC_COLLATE LC_CTYPE
  case " $AS_LC_SET " in *" LANG "*) builtin export LANG="$AS_LANG" ;; esac
  case " $AS_LC_SET " in *" LC_COLLATE "*) builtin export LC_COLLATE="$AS_LC_COLLATE" ;; esac
  case " $AS_LC_SET " in *" LC_CTYPE "*) builtin export LC_CTYPE="$AS_LC_CTYPE" ;; esac
  case " $AS_LC_SET " in *" LC_ALL "*) builtin export LC_ALL="$AS_LC_ALL" ;; esac
  return 0
}

# --- 外部程式：security、sops 與 PowerShell 用絕對路徑；其餘工具靠開頭設定的固定 PATH ---

# shellcheck disable=SC2030,SC2031  # HOME 只改給 subshell 裡的外部程式看，是刻意的
_security() {
  (
    # Keychain 的搜尋清單跟著家目錄走：不讓呼叫端的 HOME 把查詢變成「找不到」
    export HOME="$AS_HOME"
    unset CFFIXED_USER_HOME
    exec /usr/bin/security "$@"
  )
}

# shellcheck disable=SC2030,SC2031
_sops() {
  local a b bin="" key=$AS_AGE_KEY home=$AS_HOME; local -a cands args
  cands=(/opt/homebrew/bin/sops /usr/local/bin/sops /usr/bin/sops /home/linuxbrew/.linuxbrew/bin/sops)
  # Windows：scoop 裝的 sops.exe，排在既有的 Unix 路徑後面（先本體，再 shim）
  [[ $AS_STORE == wincred ]] && cands+=("$AS_HOME/scoop/apps/sops/current/sops.exe" "$AS_HOME/scoop/shims/sops.exe")
  for b in "${cands[@]}"; do
    if [[ -x $b ]]; then bin=$b; break; fi
  done
  [[ -n $bin ]] || { builtin printf 'agent-secret: 找不到 sops\n' >&2; return 127; }
  args=()
  if [[ $AS_STORE == wincred ]]; then
    # sops.exe 是原生 Windows 程式：age key、家目錄與加密檔的路徑自己用 cygpath -w 轉好，
    # 不靠 MSYS 的自動轉換（那會跟著呼叫端的 MSYS_NO_PATHCONV、MSYS2_*_CONV_EXCL 改變）
    key=$(cygpath -w -- "$AS_AGE_KEY") && home=$(cygpath -w -- "$AS_HOME") || return 1
    for a in "$@"; do
      if [[ $a == "$AS_SOPS_FILE" ]]; then a=$(cygpath -w -- "$a") || return 1; fi
      args+=("$a")
    done
  else
    args=("$@")
  fi
  (
    # 只認固定的 age key 檔；會改變 key 來源或執行外部指令的 sops 變數一律清掉
    unset SOPS_AGE_KEY SOPS_AGE_KEY_CMD SOPS_AGE_RECIPIENTS \
      SOPS_AGE_SSH_PRIVATE_KEY_FILE SOPS_AGE_SSH_PRIVATE_KEY_CMD
    export SOPS_AGE_KEY_FILE="$key" HOME="$home"
    if [[ $AS_STORE == wincred ]]; then
      unset MSYS_NO_PATHCONV MSYS2_ENV_CONV_EXCL MSYS2_ARG_CONV_EXCL
      # Go 在 Windows 上不看 HOME：家目錄是 USERPROFILE，sops 預設的 age key 位置在 APPDATA 底下
      export USERPROFILE="$home" APPDATA="$home\\AppData\\Roaming"
    fi
    exec "$bin" ${args[@]+"${args[@]}"}
  )
}

# Windows Credential Manager 的存取程式。PowerShell 只負責編譯並呼叫這段 C#：所有 Win32 呼叫與
# GetLastWin32Error 都在 C# 方法裡（從 PowerShell 讀 last error 不可靠，2026-10-10 實測）。
# 輸入：環境變數 AS_WC_OP（get|exists|put|delete|names）與 AS_WC_TARGET（只有名稱）；值只從 stdin 進（put）、
# 從 stdout 出（get，原始 bytes，不加換行）。blob 固定存 ASCII bytes，put 寫完會讀回來逐 byte 比對。
# 結束碼：0 成功、3 找不到（同時在 stdout 印 AS-WINCRED-NOT-FOUND）、其他都是錯誤。
# 讀到項目後，TargetName 必須與要求的名稱逐字相同（Credential Manager 的 target 不分大小寫）。
# names 只列 Type 為 GENERIC、前綴完全相同、名稱寫法合法的項目；列舉回 1168（沒有任何項目）算空清單。
# 內容必須是純 ASCII；長度受 Windows 指令列上限約束（base64 後約 11000 字元，上限 32767）。
IFS= read -r -d '' AS_WC_PS_SRC <<'AS_WC_EOF'
$ProgressPreference='SilentlyContinue';$ErrorActionPreference='Stop';$r=1
try{Add-Type -TypeDefinition @'
using System;using System.IO;using System.Text;using System.Text.RegularExpressions;using System.Runtime.InteropServices;
public static class AsWinCred{
const string PRE="agent-secret/",NF="AS-WINCRED-NOT-FOUND\n",OK="AS-WINCRED-OK\n",END="AS-WINCRED-END\n";
const string SHAPE=@"\A(simple/[A-Z][A-Z0-9_]*|alias/[a-z0-9][a-z0-9-]*)\z";
[StructLayout(LayoutKind.Sequential,CharSet=CharSet.Unicode)]
struct CRED{public uint Flags;public uint Type;public string TargetName;public string Comment;public uint TimeLow;public uint TimeHigh;public uint BlobSize;public IntPtr Blob;public uint Persist;public uint AttrCount;public IntPtr Attrs;public string TargetAlias;public string UserName;}
[DllImport("advapi32.dll",CharSet=CharSet.Unicode,SetLastError=true)]static extern bool CredReadW(string t,uint type,uint flags,out IntPtr c);
[DllImport("advapi32.dll",CharSet=CharSet.Unicode,SetLastError=true)]static extern bool CredWriteW(ref CRED c,uint flags);
[DllImport("advapi32.dll",CharSet=CharSet.Unicode,SetLastError=true)]static extern bool CredDeleteW(string t,uint type,uint flags);
[DllImport("advapi32.dll",CharSet=CharSet.Unicode,SetLastError=true)]static extern bool CredEnumerateW(string f,uint flags,out uint n,out IntPtr a);
[DllImport("advapi32.dll")]static extern void CredFree(IntPtr p);
static bool Printable(byte[] b){if(b==null||b.Length<1||b.Length>1024)return false;foreach(byte x in b)if(x<0x20||x>0x7e)return false;return true;}
static void Say(Stream o,string s){byte[] b=Encoding.ASCII.GetBytes(s);o.Write(b,0,b.Length);o.Flush();}
static int Read(string t,out byte[] blob){
blob=null;IntPtr p;
if(!CredReadW(t,1,0,out p)){int e=Marshal.GetLastWin32Error();return e==1168?3:1;}
try{CRED c=(CRED)Marshal.PtrToStructure(p,typeof(CRED));
if(c.Type!=1||!string.Equals(c.TargetName,t,StringComparison.Ordinal))return 1;
if(c.BlobSize>0&&c.BlobSize<=4096&&c.Blob!=IntPtr.Zero){blob=new byte[c.BlobSize];Marshal.Copy(c.Blob,blob,0,(int)c.BlobSize);}
return 0;}finally{CredFree(p);}}
static int Names(Stream o){
uint n;IntPtr a;
if(!CredEnumerateW(PRE+"*",0,out n,out a)){int e=Marshal.GetLastWin32Error();if(e!=1168)return 1;Say(o,END);return 0;}
StringBuilder sb=new StringBuilder();
try{for(int i=0;i<n;i++){CRED c=(CRED)Marshal.PtrToStructure(Marshal.ReadIntPtr(a,i*IntPtr.Size),typeof(CRED));
if(c.Type!=1||c.TargetName==null||!c.TargetName.StartsWith(PRE,StringComparison.Ordinal))continue;
string s=c.TargetName.Substring(PRE.Length);if(Regex.IsMatch(s,SHAPE))sb.Append(s).Append('\n');}}finally{CredFree(a);}
Say(o,sb.ToString()+END);return 0;}
static int Put(Stream o,string t){
byte[] buf=new byte[1025];int n=0,k;Stream i=Console.OpenStandardInput();
while(n<buf.Length&&(k=i.Read(buf,n,buf.Length-n))>0)n+=k;
if(n<1||n>1024)return 1;
byte[] v=new byte[n];Array.Copy(buf,v,n);Array.Clear(buf,0,buf.Length);
if(!Printable(v))return 1;
byte[] b;int r=Read(t,out b);if(r!=0&&r!=3)return 1;
CRED c=new CRED();c.Type=1;c.TargetName=t;c.Persist=2;c.UserName="agent-secret";c.BlobSize=(uint)n;c.Blob=Marshal.AllocHGlobal(n);
bool w;try{Marshal.Copy(v,0,c.Blob,n);w=CredWriteW(ref c,0);}finally{Marshal.Copy(new byte[n],0,c.Blob,n);Marshal.FreeHGlobal(c.Blob);}
if(!w)return 1;
if(Read(t,out b)!=0||b==null||b.Length!=n)return 1;
for(int j=0;j<n;j++)if(b[j]!=v[j])return 1;
Say(o,OK);return 0;}
public static int Run(string op,string t){
try{Stream o=Console.OpenStandardOutput();
if(op=="names")return Names(o);
if(t==null||!t.StartsWith(PRE,StringComparison.Ordinal)||!Regex.IsMatch(t.Substring(PRE.Length),SHAPE))return 1;
if(op=="put")return Put(o,t);
byte[] b;int r=Read(t,out b);
if(r==3){Say(o,NF);return 3;}
if(r!=0)return 1;
if(op=="exists"){Say(o,OK);return 0;}
if(op=="get"){if(!Printable(b))return 1;o.Write(b,0,b.Length);o.Flush();return 0;}
if(op=="delete"){if(!CredDeleteW(t,1,0)){int e=Marshal.GetLastWin32Error();if(e!=1168)return 1;Say(o,NF);return 3;}Say(o,OK);return 0;}
return 1;}catch(Exception){return 1;}}}
'@
$r=[AsWinCred]::Run($env:AS_WC_OP,$env:AS_WC_TARGET)}catch{$r=1}
exit $r
AS_WC_EOF
AS_WC_NOTFOUND=$'AS-WINCRED-NOT-FOUND\n'
AS_WC_OK=$'AS-WINCRED-OK\n'
AS_WC_END=$'AS-WINCRED-END\n'

# Windows PowerShell 5.1 的位置：從 Win32 API 回報的系統目錄推導，不看 PATH 與 SystemRoot
as_ps_bin() {
  local sys
  sys=$(cygpath -S) || return 1
  builtin printf '%s/WindowsPowerShell/v1.0/powershell.exe' "$sys"
}

# _wincred <op> [target]：最底層，以乾淨的環境啟動 PowerShell 執行上面那段程式。
# env -i 之後只給固定的幾個變數，值都從 Win32 API（cygpath）推導，不取自呼叫端的環境：
#   SystemRoot、TEMP、TMP（Add-Type 編譯 C# 需要可寫的暫存目錄；少了會退到 C:\WINDOWS 而失敗）、
#   PATH（固定的系統目錄，寫成 POSIX 形式交給 MSYS 轉換）、MSYSTEM（Git for Windows 的 runtime 會讓
#   呼叫端的 MSYSTEM 穿過 env -i，所以明確蓋掉）、PSModulePath（固定為系統模組目錄；pwsh 7 留下的
#   PSModulePath 會讓 5.1 載不到內建模組）、MSYS2_ARG_CONV_EXCL=*（base64 參數不做路徑轉換）。
# 2026-10-10 實測：呼叫端設的 COR_ENABLE_PROFILING、COR_PROFILER*、COMPLUS_*、DOTNET_*、PSModulePath、
# SystemRoot、TEMP 都到不了 PowerShell；另外只多出 runtime 自己補的 WINDIR 與 PowerShell 自己加的 PATHEXT。
# op 與 target 只有名稱（已通過格式檢查）；值不進 argv，也不寫檔。
_wincred() {
  local ps sys win tmp enc
  ps=$(as_ps_bin) && sys=$(cygpath -S) && win=$(cygpath -W) && tmp=$(cygpath -F 28) || return 1
  [[ -f $ps && -d $tmp/Temp ]] || return 1
  tmp=$(cygpath -w -- "$tmp/Temp") || return 1
  enc=$(builtin printf '%s' "$AS_WC_PS_SRC" | iconv -f UTF-8 -t UTF-16LE | base64 -w 0) || return 1
  [[ -n $enc ]] || return 1
  env -i "SystemRoot=$(cygpath -w -- "$win")" "TEMP=$tmp" "TMP=$tmp" "PATH=$sys:$win" MSYSTEM=MSYS \
    "PSModulePath=$(cygpath -w -- "$sys/WindowsPowerShell/v1.0/Modules")" \
    MSYS2_ARG_CONV_EXCL='*' "AS_WC_OP=$1" "AS_WC_TARGET=${2:-}" \
    "$ps" -NoLogo -NoProfile -NonInteractive -EncodedCommand "$enc"
}

# --- Backend ---
# 回傳值：0 成功、3 確認找不到、其他都是錯誤（呼叫端必須 fail closed）。
# get 成功時把值放進全域變數 AS_VALUE（不經 stdout，取得後不需要再用任何指令轉手）。

# backend_keychain get|exists <alias>
# backend_keychain put <alias> <tier>      值從 stdin 讀
backend_keychain() {
  local op=$1 alias=${2:-} tier=${3:-} out rc value hex line LC_ALL=C
  case "$op" in
    get)
      AS_VALUE=""
      out=$(_security find-generic-password -s "$AS_SERVICE" -a "$alias" -w 2>/dev/null); rc=$?
      if [[ $rc -eq 0 ]]; then AS_VALUE=$out; return 0; fi
      [[ $rc -eq 44 ]] && return 3   # errSecItemNotFound (-25300)，2026-10-05 實測
      return 1
      ;;
    exists)   # 不帶 -w：只讀屬性，不讀值也不觸發授權視窗
      _security find-generic-password -s "$AS_SERVICE" -a "$alias" >/dev/null 2>&1; rc=$?
      [[ $rc -eq 0 ]] && return 0
      [[ $rc -eq 44 ]] && return 3
      return 1
      ;;
    put)
      value=$(cat) || return 1
      [[ -n $value && ${#value} -le $AS_MAX_VALUE_LEN ]] || return 1
      case "$value" in *[!\ -~]*) return 1 ;; esac
      # od -v：不加的話重複的資料列會被摺成 "*"
      hex=$(builtin printf '%s' "$value" | od -An -v -tx1 | tr -d ' \n') || return 1
      [[ ${#hex} -eq $(( ${#value} * 2 )) ]] || return 1
      line="add-generic-password -U -s $AS_SERVICE -a $alias"
      # keychain-only：以空的信任清單（-T ""）建立。2026-10-05 實測這不會讓 broker 的讀取跳確認視窗，
      # 所以它不是一道讀取限制；保留只是不把其他 app 加進信任清單。
      [[ $tier == keychain-only ]] && line="$line -T \"\""
      line="$line -X $hex"
      [[ ${#line} -lt 3000 ]] || return 1
      # 指令走 stdin 交給 security -i，值不進 argv；輸出全部丟掉，避免錯誤訊息帶出內容
      builtin printf '%s\n' "$line" | _security -i >/dev/null 2>&1 || return 1
      return 0
      ;;
    delete)   # 輸出是被刪項目的屬性，不含值；一律丟掉
      _security delete-generic-password -s "$AS_SERVICE" -a "$alias" >/dev/null 2>&1; rc=$?
      [[ $rc -eq 0 ]] && return 0
      [[ $rc -eq 44 ]] && return 3
      return 1
      ;;
    names)
      # 列出本 service 底下符合簡易模式寫法的 account。dump-keychain 不帶 -d：只輸出屬性，
      # 不讀密碼、不觸發授權視窗。它會走過整個搜尋清單的所有項目，所以時間與 Keychain 總項目數
      # 成正比；這裡只做一次，再由 awk 篩出 service 完全相同的 generic password。
      _security dump-keychain 2>/dev/null | awk -v svc="$AS_SERVICE" '
        function flush() { if (cls == "\"genp\"" && ok && acct ~ /^[A-Z][A-Z0-9_]*$/) print acct; cls = ""; ok = 0; acct = "" }
        /^keychain: / { flush(); next }
        /^class: / { cls = $2; next }
        {
          line = $0; sub(/^[ \t]+/, "", line)
          if (line == "\"svce\"<blob>=\"" svc "\"") ok = 1
          else if (index(line, "\"acct\"<blob>=\"") == 1) { acct = substr(line, 15); sub(/"$/, "", acct) }
        }
        END { flush() }
      '
      [[ ${PIPESTATUS[0]} -eq 0 ]] || return 1
      return 0
      ;;
    *) return 1 ;;
  esac
}

# as_wc_call <op> [target]：呼叫 _wincred，把 stdout 原樣（含結尾的換行）放進 AS_WC_OUT 並回傳它的 exit code。
# $(...) 會吃掉結尾的換行，所以先補一個 . 再去掉：值後面多出來的 LF 或 CR 才看得到。
# stdin 由呼叫端決定（put 是 pipe，其餘是 /dev/null）；PowerShell 的 stderr 一律丟掉。
as_wc_call() {
  local rc
  AS_WC_OUT=$(_wincred "$@" 2>/dev/null; rc=$?; builtin printf .; exit "$rc"); rc=$?
  AS_WC_OUT=${AS_WC_OUT%.}
  return "$rc"
}

# backend_wincred get|exists|delete <name>
# backend_wincred put <name> <tier>      值從 stdin 讀；tier 在 Windows 沒有作用（Credential Manager 沒有逐項 ACL）
# backend_wincred names [all]            預設只印簡易模式的名稱；all 印 simple/<NAME> 與 alias/<alias>
# 回傳值與 backend_keychain 相同。「找不到」要兩個訊號同時成立：exit code 3，而且 stdout 正好是 sentinel；
# 其餘情況（PowerShell 起不來、當掉、奇怪的 exit code、輸出對不上）一律是錯誤，不會回 3。
backend_wincred() {
  local op=$1 name=${2:-} target="" rc value line LC_ALL=C
  case "$op" in
    get|exists|put|delete)
      if [[ $name =~ $AS_ENV_RE ]]; then target="$AS_SERVICE/simple/$name"
      elif [[ $name =~ $AS_ALIAS_RE ]]; then target="$AS_SERVICE/alias/$name"
      else return 1; fi
      ;;
  esac
  case "$op" in
    get)
      AS_VALUE=""
      as_wc_call get "$target" </dev/null; rc=$?
      if [[ $rc -eq 3 ]]; then
        [[ $AS_WC_OUT == "$AS_WC_NOTFOUND" ]] && return 3
        return 1
      fi
      [[ $rc -eq 0 ]] || return 1
      # C# 已經檢查過一次；這裡再驗一次才放進 AS_VALUE（結尾多出 CR 或換行也在這裡擋下）
      [[ -n $AS_WC_OUT && ${#AS_WC_OUT} -le $AS_MAX_VALUE_LEN ]] || return 1
      case "$AS_WC_OUT" in *[!\ -~]*) return 1 ;; esac
      AS_VALUE=$AS_WC_OUT; AS_WC_OUT=""
      return 0
      ;;
    exists|delete)   # exists 會把項目讀進 PowerShell 行程的記憶體，但不輸出值；Credential Manager 讀取不跳視窗
      as_wc_call "$op" "$target" </dev/null; rc=$?
      [[ $rc -eq 0 && $AS_WC_OUT == "$AS_WC_OK" ]] && return 0
      [[ $rc -eq 3 && $AS_WC_OUT == "$AS_WC_NOTFOUND" ]] && return 3
      return 1
      ;;
    put)
      value=$(cat) || return 1
      [[ -n $value && ${#value} -le $AS_MAX_VALUE_LEN ]] || return 1
      case "$value" in *[!\ -~]*) return 1 ;; esac
      # 值走 stdin 交給 PowerShell，不進 argv；stdout 只會是固定的 sentinel。
      # 用 process substitution（pipe）而不是 pipeline 或 here-string：as_wc_call 要留在目前的 shell 才設得到
      # AS_WC_OUT，here-string 在舊版 bash 會把內容寫進暫存檔。
      as_wc_call put "$target" < <(builtin printf '%s' "$value"); rc=$?
      value=""
      [[ $rc -eq 0 && $AS_WC_OUT == "$AS_WC_OK" ]] || return 1
      return 0
      ;;
    names)
      # 一次列舉（CredEnumerate）。結尾必須有 END sentinel：輸出被截斷時當成錯誤，不當成「比較少」
      as_wc_call names </dev/null; rc=$?
      [[ $rc -eq 0 && $AS_WC_OUT == *"$AS_WC_END" ]] || return 1
      AS_WC_OUT=${AS_WC_OUT%"$AS_WC_END"}
      [[ -z $AS_WC_OUT || $AS_WC_OUT == *$'\n' ]] || return 1
      while IFS= read -r line; do
        case "$line" in
          simple/*) if [[ $name == all ]]; then builtin printf '%s\n' "$line"; else builtin printf '%s\n' "${line#simple/}"; fi ;;
          alias/*) if [[ $name == all ]]; then builtin printf '%s\n' "$line"; fi ;;
          '') ;;
          *) return 1 ;;
        esac
      done <<< "$AS_WC_OUT"
      return 0
      ;;
    *) return 1 ;;
  esac
}

# backend_sops get|exists <alias>
backend_sops() {
  local op=$1 alias=${2:-} out rc
  case "$op" in
    exists)   # sops 的 key 名稱是明文，不需要解密
      [[ -e $AS_SOPS_FILE ]] || return 3
      [[ -f $AS_SOPS_FILE && -r $AS_SOPS_FILE ]] || return 1
      awk -v k="$alias" '
        BEGIN { a = k ":"; b = "\"" k "\":"; c = "\047" k "\047:" }
        index($0, a) == 1 || index($0, b) == 1 || index($0, c) == 1 { found = 1 }
        END { exit(found ? 0 : 3) }
      ' "$AS_SOPS_FILE"; rc=$?
      [[ $rc -eq 0 || $rc -eq 3 ]] && return $rc
      return 1
      ;;
    get)
      AS_VALUE=""
      [[ -e $AS_SOPS_FILE ]] || return 3
      out=$(_sops -d --extract "[\"$alias\"]" "$AS_SOPS_FILE" 2>/dev/null) || return 1
      AS_VALUE=$out
      return 0
      ;;
    names)    # 加密檔裡符合簡易模式寫法的頂層 key（key 名稱是明文，不解密）
      [[ -e $AS_SOPS_FILE ]] || return 3
      [[ -f $AS_SOPS_FILE && -r $AS_SOPS_FILE ]] || return 1
      awk '/^[A-Z][A-Z0-9_]*:/ { k = $0; sub(/:.*/, "", k); print k }' "$AS_SOPS_FILE" || return 1
      return 0
      ;;
    *) return 1 ;;
  esac
}

# envfile 不可信時印出原因（不含值）；不存在或可用時不輸出
as_envfile_problem() {
  local st
  if [[ -L $AS_ENV_FILE ]]; then builtin printf '是 symlink'; return; fi
  [[ -e $AS_ENV_FILE ]] || return 0
  if [[ ! -f $AS_ENV_FILE || ! -r $AS_ENV_FILE ]]; then builtin printf '不是可讀的一般檔案'; return; fi
  st=$(as_perm_problem "${AS_ENV_FILE%/*}")
  if [[ -n $st ]]; then builtin printf '所在目錄%s' "$st"; return; fi
  st=$(as_stat "$AS_ENV_FILE") || { builtin printf '無法取得權限資訊'; return; }
  [[ ${st%% *} == "$EUID" ]] || { builtin printf '擁有者不是目前使用者 (uid=%s)' "${st%% *}"; return; }
  [[ ${st##* } == 600 ]] || builtin printf 'mode 必須是 600 (mode=%s)' "${st##* }"
}

# backend_envfile get|exists|names <alias>
# backend_envfile put <alias>              值從 stdin 讀
# 只在非 macOS 呼叫。失敗原因放在 AS_EF_ERR（不含值）。
backend_envfile() {
  local op=$1 alias=${2:-} line k n=0 value dir tmp
  AS_EF_ERR=$(as_envfile_problem)
  [[ -z $AS_EF_ERR ]] || return 1
  case "$op" in
    get|exists)
      [[ $op == get ]] && AS_VALUE=""
      [[ -e $AS_ENV_FILE ]] || return 3
      while IFS= read -r line || [[ -n $line ]]; do
        case "$line" in ''|'#'*) continue ;; esac
        [[ $line == *=* && ${line%%=*} == "$alias" ]] || continue
        n=$((n + 1))
        [[ $op == get ]] && AS_VALUE=${line#*=}
      done < "$AS_ENV_FILE"
      line=""
      [[ $n -ge 1 ]] || return 3
      if [[ $n -gt 1 ]]; then AS_VALUE=""; AS_EF_ERR="key 重複"; return 1; fi
      return 0
      ;;
    names)
      [[ -e $AS_ENV_FILE ]] || return 3
      while IFS= read -r line || [[ -n $line ]]; do
        case "$line" in ''|'#'*) continue ;; esac
        [[ $line == *=* ]] || continue
        k=${line%%=*}
        [[ $k =~ $AS_ENV_RE ]] && builtin printf '%s\n' "$k"
      done < "$AS_ENV_FILE"
      return 0
      ;;
    put)
      value=$(cat) || return 1
      [[ -n $value && $value != *$'\n'* && $value != *$'\r'* ]] || return 1
      dir=${AS_ENV_FILE%/*}
      (
        umask 077
        # shellcheck disable=SC2174  # 上層目錄由 umask 077 決定成 700
        if [[ ! -e $dir && ! -L $dir ]]; then mkdir -p -m 700 "$dir" || exit 1; fi
        [[ -z $(as_perm_problem "$dir") ]] || exit 1
        tmp=$(mktemp "$dir/.secrets.env.XXXXXX") || exit 1
        {
          if [[ -e $AS_ENV_FILE ]]; then
            while IFS= read -r line || [[ -n $line ]]; do
              [[ $line == *=* && ${line%%=*} == "$alias" ]] && continue
              builtin printf '%s\n' "$line"
            done < "$AS_ENV_FILE"
          fi
          builtin printf '%s=%s\n' "$alias" "$value"
        } > "$tmp" && chmod 600 "$tmp" && mv -f "$tmp" "$AS_ENV_FILE" && exit 0
        rm -f "$tmp"
        exit 1
      ) || return 1
      return 0
      ;;
    *) return 1 ;;
  esac
}

# --- Alias 表 ---

as_stat() { # <path> -> "uid mode"（跟隨 symlink；GNU 與 BSD stat 都支援）
  stat -L -c '%u %a' -- "$1" 2>/dev/null || stat -L -f '%u %Lp' -- "$1" 2>/dev/null
}

as_perm_problem() { # <path> -> 有問題時印出說明，沒問題不輸出
  local st uid mode
  st=$(as_stat "$1") || { builtin printf '無法取得權限資訊'; return; }
  uid=${st%% *}; mode=${st##* }
  [[ $uid == "$EUID" ]] || { builtin printf '擁有者不是目前使用者 (uid=%s)' "$uid"; return; }
  [[ $mode =~ ^[0-7]+$ ]] || { builtin printf '無法解析權限 (%s)' "$mode"; return; }
  (( (8#$mode & 8#022) == 0 )) || builtin printf 'group/other 可寫 (mode=%s)' "$mode"
}

as_check_table() {
  local p
  [[ -e $AS_TABLE ]] || die "alias 表不存在: $AS_TABLE"
  [[ -f $AS_TABLE && -r $AS_TABLE ]] || die "alias 表不是可讀的一般檔案: $AS_TABLE"
  p=$(as_perm_problem "$AS_TABLE"); [[ -z $p ]] || die "alias 表 $AS_TABLE: $p"
  p=$(as_perm_problem "${AS_TABLE%/*}"); [[ -z $p ]] || die "alias 表所在目錄 ${AS_TABLE%/*}: $p"
}

as_valid_alias() { [[ $1 =~ $AS_ALIAS_RE && $1 != sops ]]; }   # sops 是加密檔的 metadata key

# 簡易模式的名稱：就是注入的環境變數名稱，所以沿用 env_name 的格式與拒絕清單
as_valid_simple() { as_valid_env "$1"; }

AS_BAD_NAME="名稱不合法：已登記的 alias 是小寫加 -（^[a-z0-9][a-z0-9-]*\$）；簡易模式是大寫環境變數寫法（^[A-Z][A-Z0-9_]*\$），且不能是 PATH、HOME、LD_* 這類會改變執行行為的變數"

as_valid_tier() { [[ $1 == keychain-only || $1 == sops ]]; }

as_valid_env() {
  [[ $1 =~ $AS_ENV_RE ]] || return 1
  case "$1" in
    LD_*|DYLD_*|BASH*|GIT_CONFIG*) return 1 ;;
    PATH|HOME|SHELL|IFS|ENV|CDPATH|PS4|PROMPT_COMMAND|SHELLOPTS|GLOBIGNORE|ZDOTDIR) return 1 ;;
    USER|LOGNAME|PWD|OLDPWD|TMPDIR|TERM|EDITOR|VISUAL|PAGER|HOSTALIASES) return 1 ;;
    UID|EUID|PPID|GROUPS|RANDOM|SECONDS|LINENO|FUNCNAME|DIRSTACK|HOSTNAME|OPTIND|OPTARG) return 1 ;;
    PYTHONPATH|PYTHONSTARTUP|PYTHONHOME|NODE_OPTIONS|NODE_PATH|PERL5LIB|PERL5OPT|RUBYOPT|RUBYLIB) return 1 ;;
    JAVA_TOOL_OPTIONS|GIT_SSH|GIT_SSH_COMMAND|GIT_EXEC_PATH|GIT_ASKPASS|SSH_ASKPASS|SUDO_ASKPASS) return 1 ;;
    POSIXLY_CORRECT|CFFIXED_USER_HOME) return 1 ;;
  esac
  return 0
}

as_valid_allowed() { # "*" 或以逗號分隔的絕對路徑
  local e; local -a list
  [[ $1 == '*' ]] && return 0
  [[ -n $1 && $1 != *,,* && $1 != ,* && $1 != *, ]] || return 1
  IFS=, read -r -a list <<< "$1"
  for e in "${list[@]}"; do [[ $e == /* ]] || return 1; done
  return 0
}

# as_lookup <alias>：以固定字串逐欄比對，設定 AS_TIER / AS_ENV / AS_ALLOWED
as_lookup() {
  local want=$1 line a t e c pipes n=0
  AS_TIER=""; AS_ENV=""; AS_ALLOWED=""
  while IFS= read -r line || [[ -n $line ]]; do
    case "$line" in ''|'#'*) continue ;; esac
    a=${line%%|*}
    [[ $a == "$want" ]] || continue
    n=$((n + 1))
    pipes=${line//[^|]/}
    [[ ${#pipes} -eq 3 ]] || die "alias 表的列格式錯誤（需要 4 欄）: $want"
    IFS='|' read -r a t e c <<< "$line"
    AS_TIER=$t; AS_ENV=$e; AS_ALLOWED=$c
  done < "$AS_TABLE"
  [[ $n -ge 1 ]] || die "未知的 alias: $want"
  [[ $n -eq 1 ]] || die "alias 表有重複列: $want"
  as_valid_tier "$AS_TIER" || die "tier 不合法: $want"
  as_valid_env "$AS_ENV" || die "env_name 不合法或會改變執行行為: $want"
  as_valid_allowed "$AS_ALLOWED" || die "allowed_commands 必須是 * 或逗號分隔的絕對路徑: $want"
}

# --- 指令檢查 ---

# <command> -> 絕對路徑（不解開最後一層 symlink，allowlist 比對的是這個字串）。
# 沒有斜線的名稱用呼叫端原本的 PATH 找：最後 exec 的就是這個絕對路徑。
# Windows：C:\... 與 C:/... 先轉成 MSYS 寫法；MSYS 會把沒有副檔名的名稱透明地對到同目錄的 .exe，實際要執行的是
# 那個 .exe 時（-ef：同一個檔案）就把字串補成 .exe，allowlist 與拒絕清單看到的才是磁碟上真正的檔名。
as_resolve_cmd() {
  local c=$1 d dir base
  if [[ $AS_STORE == wincred ]]; then
    case "$c" in *\\*|[A-Za-z]:/*) c=$(cygpath -u -- "$c") || return 1 ;; esac
  fi
  case "$c" in
    */*) ;;
    *) c=$(PATH=$AS_CALLER_PATH; builtin type -P -- "$c") || return 1 ;;
  esac
  [[ -n $c ]] || return 1
  base=${c##*/}
  [[ -n $base && $base != . && $base != .. ]] || return 1
  case "$c" in */*) d=${c%/*}; [[ -n $d ]] || d=/ ;; *) d=. ;; esac
  dir=$(builtin cd -- "$d" 2>/dev/null && builtin pwd -L) || return 1
  if [[ $AS_STORE == wincred && $base != *.exe && -f ${dir%/}/$base.exe && ${dir%/}/$base -ef ${dir%/}/$base.exe ]]; then
    base=$base.exe
  fi
  builtin printf '%s/%s' "${dir%/}" "$base"
}

as_realpath() { # <絕對路徑> -> 解開 symlink 後的路徑
  local p=$1 t dir i=0
  while [[ -L $p ]]; do
    i=$((i + 1)); [[ $i -le 40 ]] || return 1
    t=$(readlink -- "$p") || return 1
    case "$t" in /*) p=$t ;; *) p="${p%/*}/$t" ;; esac
  done
  dir=$(builtin cd -- "${p%/*}/" 2>/dev/null && builtin pwd -P) || return 1
  builtin printf '%s/%s' "${dir%/}" "${p##*/}"
}

# 最直接會把環境印出來、或能執行任意程式碼的指令。只在 allowed_commands 列出明確路徑時套用，
# 防止把 shell 或直譯器登記成「被允許的指令」；allowed_commands 是 * 時不套用。
# 這份名單刻意不再擴充，也一定不完整：邊界是明確的絕對路徑清單，不是這份名單。
# 比對前先轉小寫並去掉結尾的 .exe（Bash.EXE、cmd.exe 這類寫法與不分大小寫的檔案系統）；轉換失敗就當成拒絕。
as_cmd_denied() { # <basename>
  local b
  b=$(builtin printf '%s' "$1" | tr 'A-Z' 'a-z') || return 0
  b=${b%.exe}
  case "$b" in
    env|printenv|set|export|declare|typeset|echo|printf|cat|tee|xargs|eval|exec|command|builtin) return 0 ;;
    sh|bash|zsh|fish|dash|ksh|csh|tcsh|ash|busybox|nu|pwsh|rbash|cmd|powershell) return 0 ;;
    python|python[0-9]*|pypy*|perl|perl[0-9]*|ruby|ruby[0-9]*|node|nodejs|bun|bunx|deno|npx|uv|uvx) return 0 ;;
    php|php[0-9]*|lua|lua[0-9]*|luajit|tclsh*|wish*|expect|osascript|swift|rscript|awk|gawk|mawk|nawk|sed) return 0 ;;
    sudo|doas|su|nohup|nice|time|timeout|gtimeout|watch|script|strace|ltrace|dtruss|gdb|lldb) return 0 ;;
    make|gmake|just|find|gfind|ssh|vi|vim|nvim|emacs|nano|less|more|man|tmux|screen|open|docker|podman) return 0 ;;
  esac
  return 1
}

# as_check_cmd <command>：通過時把要 exec 的絕對路徑放進 AS_CMD
as_check_cmd() {
  local abs real e ok=0; local -a list
  abs=$(as_resolve_cmd "$1") || die "找不到指令: $1"
  [[ -f $abs && -x $abs ]] || die "指令不是可執行檔: $abs"
  # *：沒有指令限制，與簡易模式相同
  if [[ $AS_ALLOWED == '*' ]]; then AS_CMD=$abs; return 0; fi
  real=$(as_realpath "$abs") || die "無法解析指令路徑: $abs"
  if as_cmd_denied "${abs##*/}" || as_cmd_denied "${real##*/}"; then
    die "指令在內建拒絕清單內（會印出環境或執行任意程式碼），即使列在 allowed_commands 也不允許: $abs"
  fi
  IFS=, read -r -a list <<< "$AS_ALLOWED"
  for e in "${list[@]}"; do [[ $e == "$abs" ]] && ok=1; done
  [[ $ok -eq 1 ]] || die "指令不在 alias 的 allowed_commands 內: $abs"
  AS_CMD=$abs
}

# as_simple_guard <NAME>：規格是「名稱不在 alias 表裡」才走簡易模式。表存在時逐列比對第一欄
# （固定字串，不論該列是否合法、表的權限是否正確），有同名的列就拒絕。表不存在則沒有東西要比。
as_simple_guard() {
  local want=$1 line
  [[ -e $AS_TABLE ]] || return 0
  [[ -f $AS_TABLE && -r $AS_TABLE ]] || die "alias 表不是可讀的一般檔案，無法確認名稱沒有被登記: $AS_TABLE"
  while IFS= read -r line || [[ -n $line ]]; do
    case "$line" in ''|'#'*) continue ;; esac
    if [[ ${line%%|*} == "$want" ]]; then
      die "alias 表內有同名的列: ${want}。表內的 alias 必須是小寫加 -；大寫名稱保留給簡易模式，請把表內那一列改名或移除"
    fi
  done < "$AS_TABLE"
  return 0
}

# as_simple_cmd <command>：簡易模式只把指令解析成絕對路徑，不比對 allowed_commands，也不套拒絕清單
as_simple_cmd() {
  local abs
  abs=$(as_resolve_cmd "$1") || die "找不到指令: $1"
  [[ -f $abs && -x $abs ]] || die "指令不是可執行檔: $abs"
  AS_CMD=$abs
}

# --- 子指令 ---

cmd_run() {
  local alias backend rc mode
  [[ $# -ge 3 && $2 == -- ]] || die "usage: agent-secret run <name> -- <command> [args...]"
  alias=$1; shift 2
  if as_valid_alias "$alias"; then
    mode=registered
    as_check_table
    as_lookup "$alias"
    as_check_cmd "$1"
  elif as_valid_simple "$alias"; then
    # 簡易模式：不讀 alias 表；解析順序同 sops tier，名稱就是環境變數名稱
    mode=simple
    as_simple_guard "$alias"
    AS_TIER=sops; AS_ENV=$alias
    as_simple_cmd "$1"
  else
    die "$AS_BAD_NAME"
  fi
  shift

  AS_VALUE=""; backend=""
  if [[ $AS_STORE != none ]]; then
    backend_store get "$alias"; rc=$?
    if [[ $rc -eq 0 ]]; then
      backend=$AS_STORE
    elif [[ $rc -ne 3 ]]; then
      die "$AS_STORE_LABEL 讀取失敗（上鎖、拒絕或其他錯誤），不改用其他來源: $alias"
    elif [[ $AS_TIER == keychain-only ]]; then
      die "$AS_STORE_LABEL 沒有這個項目（keychain-only 不查 sops）: $alias"
    fi
  elif [[ $AS_TIER == keychain-only ]]; then
    die "keychain-only 的 alias 只能在 macOS 使用: $alias"
  else
    # 沒有本機儲存區的平台（Linux 等）：envfile 確認沒有這個 key 才查 sops
    backend_envfile get "$alias"; rc=$?
    if [[ $rc -eq 0 ]]; then
      backend=envfile
    elif [[ $rc -ne 3 ]]; then
      die "envfile 無法使用（${AS_EF_ERR:-讀取失敗}），不改用其他來源: $alias"
    fi
  fi
  if [[ -z $backend ]]; then
    backend_sops get "$alias"; rc=$?
    [[ $rc -eq 0 ]] || die "sops 讀取失敗（項目不存在或解密失敗）: $alias"
    backend=sops
  fi
  [[ -n $AS_VALUE ]] || die "值為空: $alias"

  # 從這裡到 exec 只用 builtin 與賦值：值不交給任何可被遮蔽的名稱
  if [[ $mode == simple ]]; then
    builtin printf 'agent-secret: name=%s backend=%s mode=simple\n' "$alias" "$backend" >&2
  else
    builtin printf 'agent-secret: alias=%s backend=%s\n' "$alias" "$backend" >&2
  fi
  PATH=$AS_CALLER_PATH
  as_restore_locale
  # Windows：MSYS 在啟動原生程式時會把看起來像 POSIX 路徑的環境變數值改寫成 Windows 路徑
  # （實測 /abc/def 變成 C:/Program Files/Git/abc/def）。把注入的變數列進排除清單，值才會原樣送到。
  if [[ $AS_STORE == wincred ]]; then
    builtin export MSYS2_ENV_CONV_EXCL="$AS_ENV${MSYS2_ENV_CONV_EXCL:+;$MSYS2_ENV_CONV_EXCL}"
  fi
  builtin export "$AS_ENV=$AS_VALUE" || die "無法設定環境變數: $AS_ENV"
  AS_VALUE=""
  builtin exec "$AS_CMD" ${1+"$@"}
}

cmd_put() {
  local alias value rc tier p LC_ALL=C
  [[ $# -eq 1 ]] || die "usage: agent-secret put <name>   （值從 stdin 讀，或在 terminal 提示輸入）"
  alias=$1
  if as_valid_alias "$alias"; then tier=""
  elif as_valid_simple "$alias"; then tier=simple; as_simple_guard "$alias"
  else die "$AS_BAD_NAME"; fi
  if [[ -z $tier ]]; then
    as_check_table
    as_lookup "$alias"
    tier=$AS_TIER
  fi
  # 沒有本機儲存區的平台（Linux 等）寫 envfile；macOS 與 Windows 寫本機儲存區，不碰 envfile
  if [[ $AS_STORE == none ]]; then
    [[ $tier != keychain-only ]] || die "keychain-only 的 alias 只能在 macOS 使用: $alias"
    p=$(as_envfile_problem); [[ -z $p ]] || die "envfile $AS_ENV_FILE 無法使用（$p）: $alias"
  fi
  backend_sops exists "$alias"; rc=$?
  [[ $rc -ne 0 ]] || die "sops 已有同名項目，同一個 secret 不放兩個來源: $alias"
  [[ $rc -eq 3 ]] || die "無法確認 sops 是否已有同名項目: $alias"

  if [[ -t 0 ]]; then
    builtin printf '%s 的值（輸入不顯示）：' "$alias" >&2
    builtin read -rs value || die "讀取輸入失敗"
    builtin printf '\n' >&2
  else
    value=$(cat) || die "讀取 stdin 失敗"
    # Windows：PowerShell 經 pipe 送出的行尾是 CRLF（Get-Clipboard | agent-secret put 就是）。Git for Windows 的
    # bash 在 $(...) 會把結尾的 CRLF 當成換行一起去掉（bash 5.3.15 cygwin，2026-10-10 實測），所以這裡不另外處理；
    # 值中間或結尾多出來的 CR 仍然被下面的檢查拒絕。
  fi
  [[ -n $value ]] || die "值為空"
  if [[ $AS_STORE == wincred ]]; then
    [[ ${#value} -le $AS_MAX_VALUE_LEN ]] || die "值超過 $AS_MAX_VALUE_LEN 字元（上限與 Keychain 相同）；改放 sops（agent-secret edit）"
  else
    [[ ${#value} -le $AS_MAX_VALUE_LEN ]] || die "值超過 $AS_MAX_VALUE_LEN 字元，Keychain 寫入會被截斷；改放 sops（agent-secret edit）"
  fi
  case "$value" in *[!\ -~]*) die "值只能是單行可列印 ASCII；其他內容改放 sops（agent-secret edit）" ;; esac

  if [[ $AS_STORE == none ]]; then
    builtin printf '%s' "$value" | backend_envfile put "$alias" || die "envfile 寫入失敗: $alias"
    value=""
    builtin printf 'agent-secret: stored alias=%s backend=envfile tier=%s\n' "$alias" "$tier" >&2
    return 0
  fi
  builtin printf '%s' "$value" | backend_store put "$alias" "$tier" || die "$AS_STORE_LABEL 寫入失敗: $alias"
  value=""
  builtin printf 'agent-secret: stored alias=%s backend=%s tier=%s\n' "$alias" "$AS_STORE" "$tier" >&2
}

cmd_rm() {
  local name rc
  [[ $# -eq 1 ]] || die "usage: agent-secret rm <NAME>   （只限簡易模式的名稱）"
  name=$1
  if as_valid_alias "$name"; then
    die "rm 只處理簡易模式的名稱；已登記的 alias 不由這個指令刪除: $name"
  fi
  as_valid_simple "$name" || die "$AS_BAD_NAME"
  as_simple_guard "$name"
  [[ $AS_STORE != none ]] || die "rm 只刪 Keychain 的項目，只能在 macOS 使用；sops 的項目用 agent-secret edit"
  backend_store delete "$name"; rc=$?
  [[ $rc -ne 3 ]] || die "$AS_STORE_LABEL 沒有這個項目: $name"
  [[ $rc -eq 0 ]] || die "$AS_STORE_LABEL 刪除失敗: $name"
  builtin printf 'agent-secret: removed name=%s backend=%s mode=simple\n' "$name" "$AS_STORE" >&2
}

cmd_edit() {
  [[ $# -eq 0 ]] || die "usage: agent-secret edit"
  [[ -f $AS_AGE_KEY ]] || die "age key 不存在: ${AS_AGE_KEY}（先執行 sec init）"
  [[ -f $AS_SOPS_CFG ]] || die "找不到 ${AS_SOPS_CFG}（先執行 sec init 產生 creation_rules）"
  # PATH 已換成系統目錄：沒有斜線的 editor 名稱改用呼叫端 PATH 解析成絕對路徑，其餘參數照留
  local var val first abs
  for var in SOPS_EDITOR EDITOR; do
    [[ -n ${!var-} ]] || continue
    val=${!var}
    first=${val%%[[:space:]]*}
    [[ $first == */* ]] && continue
    abs=$(as_resolve_cmd "$first") || die "找不到 $var 指定的 editor: $first"
    builtin export "$var=$abs${val:${#first}}"
  done
  # --config 明確指定：sops 預設從 cwd 往上找 .sops.yaml
  if ! _sops --config "$AS_SOPS_CFG" "$AS_SOPS_FILE"; then
    cat >&2 <<EOF
agent-secret: sops 沒有成功結束。
  - 若訊息是 "no matching creation rules"：$AS_SOPS_CFG 的 creation_rules 沒有涵蓋
    agent.enc.yaml。補一條不帶 path_regex（或 path_regex 含 agent\\.enc\\.yaml）的規則，
    recipient 用 sec status 顯示的 public key；或重跑 sec init（會把規則改回單一全域規則）。
  - 若是解密失敗：確認 $AS_AGE_KEY 對應 .sops.yaml 的 recipient。
  - 檔案格式是一層的 alias: value，alias 要與 $AS_TABLE 一致。
EOF
    exit 1
  fi
}

# 逐列讀 alias 表並呼叫 callback <alias> <tier> <env> <allowed> <列是否合法 0|1>
as_each_row() {
  local cb=$1 line a t e c pipes valid
  while IFS= read -r line || [[ -n $line ]]; do
    case "$line" in ''|'#'*) continue ;; esac
    pipes=${line//[^|]/}; a=""; t=""; e=""; c=""
    IFS='|' read -r a t e c <<< "$line"
    valid=1
    if [[ ${#pipes} -ne 3 ]] || ! as_valid_alias "$a" || ! as_valid_tier "$t" \
      || ! as_valid_env "$e" || ! as_valid_allowed "$c"; then valid=0; fi
    "$cb" "$a" "$t" "$e" "$c" "$valid"
  done < "$AS_TABLE"
}

as_presence() { # <backend function> <alias> -> yes|no|error
  "$1" exists "$2"
  case $? in 0) builtin printf yes ;; 3) builtin printf no ;; *) builtin printf error ;; esac
}

# Windows：每次呼叫 PowerShell 約 1 秒，所以 list / doctor 每次執行只列舉一次（names all），
# 各列在 Credential Manager 有沒有項目都從這份結果查，不逐列呼叫 exists。
as_store_scan() {
  AS_WC_ALL=""; AS_WC_ERR=0
  [[ $AS_STORE == wincred ]] || return 0
  AS_WC_ALL=$(backend_wincred names all) || { AS_WC_ALL=""; AS_WC_ERR=1; return 0; }
  [[ -z $AS_WC_ALL ]] || AS_WC_ALL="$AS_WC_ALL"$'\n'
  return 0
}

as_store_presence() { # <alias> -> yes|no|error（本機儲存區）
  if [[ $AS_STORE == wincred ]]; then
    if [[ $AS_WC_ERR -eq 1 ]]; then builtin printf error
    elif as_in_lines "$AS_WC_ALL" "alias/$1"; then builtin printf yes
    else builtin printf no; fi
    return
  fi
  as_presence "backend_$AS_STORE" "$1"
}

as_list_row() {
  local kc=n/a sp ef=n/a
  if [[ $5 -ne 1 ]]; then builtin printf '%s\t%s\tINVALID\n' "$1" "$2"; return; fi
  if [[ $AS_STORE == none ]]; then ef=$(as_presence backend_envfile "$1"); else kc=$(as_store_presence "$1"); fi
  sp=$(as_presence backend_sops "$1")
  # Windows 不碰 envfile：沒有 envfile 欄，keychain 欄改叫 wincred
  if [[ $AS_STORE == wincred ]]; then
    builtin printf '%s\t%s\t%s=%s\tsops=%s\tenv=%s\tcmds=%s\n' "$1" "$2" "$AS_STORE_COL" "$kc" "$sp" "$3" "$4"
  else
    builtin printf '%s\t%s\tkeychain=%s\tsops=%s\tenvfile=%s\tenv=%s\tcmds=%s\n' "$1" "$2" "$kc" "$sp" "$ef" "$3" "$4"
  fi
}

# 收集簡易模式的名稱：AS_KC_NAMES / AS_SP_NAMES / AS_EF_NAMES（各一行一個）、AS_SIMPLE_NAMES（聯集）、AS_NAMES_ERR
as_simple_names() {
  local raw rc n LC_ALL=C
  AS_KC_NAMES=""; AS_SP_NAMES=""; AS_EF_NAMES=""; AS_SIMPLE_NAMES=""; AS_NAMES_ERR=""
  if [[ $AS_STORE == wincred ]]; then
    # as_store_scan 已經列舉過：這裡只挑出 simple/ 開頭的
    if [[ $AS_WC_ERR -eq 1 ]]; then AS_NAMES_ERR="wincred"
    else
      while IFS= read -r n; do
        case "$n" in simple/*) n=${n#simple/}; as_valid_simple "$n" && AS_KC_NAMES="$AS_KC_NAMES$n"$'\n' ;; esac
      done <<< "$AS_WC_ALL"
    fi
  elif [[ $AS_STORE == keychain ]]; then
    raw=$(backend_keychain names); rc=$?
    if [[ $rc -eq 0 || $rc -eq 3 ]]; then
      while IFS= read -r n; do as_valid_simple "$n" && AS_KC_NAMES="$AS_KC_NAMES$n"$'\n'; done <<< "$raw"
    else AS_NAMES_ERR="keychain"; fi
  else
    raw=$(backend_envfile names); rc=$?
    if [[ $rc -eq 0 || $rc -eq 3 ]]; then
      while IFS= read -r n; do as_valid_simple "$n" && AS_EF_NAMES="$AS_EF_NAMES$n"$'\n'; done <<< "$raw"
    else AS_NAMES_ERR="envfile"; fi
  fi
  raw=$(backend_sops names); rc=$?
  if [[ $rc -eq 0 || $rc -eq 3 ]]; then
    while IFS= read -r n; do as_valid_simple "$n" && AS_SP_NAMES="$AS_SP_NAMES$n"$'\n'; done <<< "$raw"
  else AS_NAMES_ERR="${AS_NAMES_ERR:+$AS_NAMES_ERR }sops"; fi
  AS_SIMPLE_NAMES=$(builtin printf '%s%s%s' "$AS_KC_NAMES" "$AS_SP_NAMES" "$AS_EF_NAMES" | sort -u)
  return 0
}

as_in_lines() { case $'\n'"$1" in *$'\n'"$2"$'\n'*) return 0 ;; esac; return 1; }   # <各行以換行結尾的清單> <名稱>

cmd_list() {
  local n kc sp ef
  as_store_scan
  builtin printf '# registered（alias 表；allowed_commands 列出路徑才有限制）\n'
  if [[ -e $AS_TABLE ]]; then
    as_check_table
    as_each_row as_list_row
  else
    builtin printf '# （alias 表不存在: %s）\n' "$AS_TABLE"
  fi
  builtin printf '# simple（取得值的指令沒有限制）\n'
  as_simple_names
  while IFS= read -r n; do
    [[ -n $n ]] || continue
    kc=n/a; sp=no; ef=n/a
    if [[ $AS_STORE != none ]]; then kc=no; as_in_lines "$AS_KC_NAMES" "$n" && kc=yes
    else ef=no; as_in_lines "$AS_EF_NAMES" "$n" && ef=yes; fi
    as_in_lines "$AS_SP_NAMES" "$n" && sp=yes
    if [[ $AS_STORE == wincred ]]; then
      builtin printf '%s\tsimple\t%s=%s\tsops=%s\n' "$n" "$AS_STORE_COL" "$kc" "$sp"
    else
      builtin printf '%s\tsimple\tkeychain=%s\tsops=%s\tenvfile=%s\n' "$n" "$kc" "$sp" "$ef"
    fi
  done <<< "$AS_SIMPLE_NAMES"
  [[ -z $AS_NAMES_ERR ]] || die "無法列舉簡易模式的名稱: ${AS_NAMES_ERR}"
}

as_doctor_row() {
  local kc=no sp
  if [[ $5 -ne 1 ]]; then builtin printf 'PROBLEM 列不合法: %s\n' "$1"; AS_PROBLEMS=$((AS_PROBLEMS + 1)); return; fi
  case " $AS_SEEN " in
    *" $1 "*) builtin printf 'PROBLEM 重複列: %s\n' "$1"; AS_PROBLEMS=$((AS_PROBLEMS + 1)) ;;
  esac
  AS_SEEN="$AS_SEEN $1"
  [[ $AS_STORE != none ]] && kc=$(as_store_presence "$1")
  sp=$(as_presence backend_sops "$1")
  if [[ $kc == error || $sp == error ]]; then
    builtin printf 'PROBLEM 無法確認 backend 狀態: %s (%s=%s sops=%s)\n' "$1" "$AS_STORE_COL" "$kc" "$sp"; AS_PROBLEMS=$((AS_PROBLEMS + 1))
  fi
  if [[ $kc == yes && $sp == yes ]]; then
    builtin printf 'PROBLEM 兩個 backend 都有: %s（%s 會蓋過 sops）\n' "$1" "$AS_STORE_LABEL"; AS_PROBLEMS=$((AS_PROBLEMS + 1))
  fi
  if [[ $2 == keychain-only && $sp == yes ]]; then
    builtin printf 'PROBLEM keychain-only 的 alias 出現在 sops: %s\n' "$1"; AS_PROBLEMS=$((AS_PROBLEMS + 1))
  fi
  if [[ $4 == '*' && $2 == keychain-only && $AS_STORE == wincred ]]; then
    builtin printf 'WARN keychain-only 且 allowed_commands 是 *：沒有任何讀取限制（Credential Manager 讀取不需要確認，同一個使用者的任何行程都讀得到）；production 項目請列出明確的絕對路徑: %s\n' "$1"
  elif [[ $4 == '*' && $2 == keychain-only ]]; then
    builtin printf 'WARN keychain-only 且 allowed_commands 是 *：沒有任何讀取限制（keychain-only 不會跳確認視窗，2026-10-05 實測）；production 項目請列出明確的絕對路徑: %s\n' "$1"
  elif [[ $4 == '*' ]]; then
    builtin printf 'INFO allowed_commands 是 *：沒有指令限制（與簡易模式相同）；要限制請列出明確的絕對路徑: %s\n' "$1"
  fi
}

cmd_doctor() {
  local p self st mode d n count=0
  AS_PROBLEMS=0; AS_SEEN=""
  as_store_scan

  self=${BASH_SOURCE[0]}
  case "$self" in */*) d=${self%/*}; [[ -n $d ]] || d=/ ;; *) d=. ;; esac
  self=$(as_realpath "$(builtin cd -- "$d" && builtin pwd -L)/${self##*/}") || self=""
  if [[ -z $self ]]; then
    builtin printf 'PROBLEM 無法解析腳本路徑\n'; AS_PROBLEMS=$((AS_PROBLEMS + 1))
  else
    for p in "$self" "${self%/*}"; do
      st=$(as_perm_problem "$p")
      if [[ -n $st ]]; then builtin printf 'PROBLEM 腳本 %s: %s\n' "$p" "$st"; AS_PROBLEMS=$((AS_PROBLEMS + 1)); fi
    done
  fi

  if [[ ! -f $AS_TABLE ]]; then
    builtin printf 'PROBLEM alias 表不存在: %s\n' "$AS_TABLE"; AS_PROBLEMS=$((AS_PROBLEMS + 1))
  else
    for p in "$AS_TABLE" "${AS_TABLE%/*}"; do
      st=$(as_perm_problem "$p")
      if [[ -n $st ]]; then builtin printf 'PROBLEM alias 表 %s: %s\n' "$p" "$st"; AS_PROBLEMS=$((AS_PROBLEMS + 1)); fi
    done
    st=$(as_stat "$AS_TABLE"); mode=${st##* }
    if [[ $mode =~ ^[0-7]+$ ]] && (( (8#$mode & 8#044) != 0 )); then
      builtin printf 'WARN alias 表 group/other 可讀 (mode=%s)，建議 chmod 600\n' "$mode"
    fi
    if [[ -r $AS_TABLE ]]; then as_each_row as_doctor_row; fi
  fi
  if [[ $AS_STORE == wincred ]]; then
    builtin printf 'INFO Windows：上面的擁有者與 mode 檢查讀的是 MSYS 合成的 POSIX mode，不是 NTFS ACL，在這個平台不構成真正的邊界\n'
  fi

  as_simple_names
  while IFS= read -r n; do
    [[ -n $n ]] || continue
    count=$((count + 1))
    if as_in_lines "$AS_KC_NAMES" "$n" && as_in_lines "$AS_SP_NAMES" "$n"; then
      builtin printf 'WARN 簡易模式的名稱兩個 backend 都有: %s（%s 會蓋過 sops）\n' "$n" "$AS_STORE_LABEL"
    fi
  done <<< "$AS_SIMPLE_NAMES"
  builtin printf 'INFO 簡易模式 %s 個名稱：取得值的指令沒有限制，agent 技術上可以把值印出來；production 或高權限的項目請在 alias 表登記並列出明確的絕對路徑\n' "$count"
  [[ -z $AS_NAMES_ERR ]] || builtin printf 'WARN 無法列舉簡易模式的名稱（%s）\n' "$AS_NAMES_ERR"

  if [[ $AS_PROBLEMS -eq 0 ]]; then builtin printf 'ok\n'; return 0; fi
  builtin printf '%s 個問題\n' "$AS_PROBLEMS"
  return 1
}

as_usage() {
  cat >&2 <<'EOF'
usage: agent-secret run <name> -- <command> [args...]
       agent-secret put <name>       在 terminal 會提示輸入（不顯示）；也可從 stdin 讀。macOS 寫 Keychain，
                                     Windows 寫 Credential Manager，
                                     其他平台寫 envfile（~/.config/agent-secret/secrets.env，mode 600）
       agent-secret rm <NAME>        刪除簡易模式在 Keychain 或 Credential Manager 的項目（其他平台不支援）
       agent-secret edit | list | doctor

本機儲存區：macOS 是 Keychain，Windows（Git for Windows 的 bash）是 Credential Manager；其他平台沒有，
改用 envfile。macOS 與 Windows 不讀也不寫 envfile。PowerShell 可經 agent-secret.ps1 呼叫。

list 的欄位（tab 分隔，不含值）：
  已登記   <alias> <tier> keychain=yes|no sops=yes|no envfile=yes|no env=<注入的環境變數> cmds=<* 或允許的絕對路徑>
  簡易模式 <NAME>  simple keychain=yes|no sops=yes|no envfile=yes|no   （NAME 就是環境變數名稱，指令沒有限制）
  macOS 的 envfile 欄是 n/a（不碰 envfile）；Linux 等其他平台的 keychain 欄是 n/a。
  Windows 的 keychain= 欄位改叫 wincred=，而且沒有 envfile 欄。

解析順序：macOS 是 Keychain 再 sops；Windows 是 Credential Manager 再 sops；其他平台是 envfile 再 sops。
前一層確認「沒有」才查下一層，其他錯誤（上鎖、權限不對、key 重複、PowerShell 起不來、解密失敗）一律
fail closed。keychain-only 只在 macOS 與 Windows 可用，其他平台一律拒絕。

兩種模式，由名稱的寫法決定：
  簡易模式   MY_TOKEN 這種大寫環境變數寫法。不用登記：put 存進本機儲存區（其他平台是 envfile），run 時注入成同名的環境變數。
             方便，但取得值的指令沒有限制（sh -c 也行），agent 技術上可以把值印出來。
  已登記     my-token 這種小寫加 - 的寫法，必須寫在 alias 表裡。allowed_commands 列出絕對路徑時
             只有那些路徑可以取用；寫成 * 就沒有限制。production 或高權限的項目應該登記並
             列出明確路徑。Windows 要寫 MSYS 寫法並含 .exe，例如 /c/Users/<name>/scoop/shims/gh.exe。

tier：keychain-only 只表示值只存在這台機器的 Keychain 或 Credential Manager（永不查 sops、不進 repo）；
      它不提供讀取時的確認（2026-10-05 實測不會跳確認視窗）。限制只來自 allowed_commands。

指令限制一句話：有列出絕對路徑才有限制；* 與簡易模式都沒有限制。
EOF
  exit 1
}

as_main() {
  local mode=${1:-}
  [[ $# -ge 1 ]] && shift
  as_paths
  case "$mode" in
    run)    cmd_run ${1+"$@"} ;;
    put)    cmd_put ${1+"$@"} ;;
    rm)     cmd_rm ${1+"$@"} ;;
    edit)   cmd_edit ${1+"$@"} ;;
    list)   cmd_list ;;
    doctor) cmd_doctor ;;
    *)      as_usage ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  as_main ${1+"$@"}
fi
