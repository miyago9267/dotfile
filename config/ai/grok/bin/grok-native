#!/bin/bash
# Run Grok with native-only discovery while retaining Grok state and auth.

set -euo pipefail

REAL_HOME="${HOME}"
GROK_STATE_HOME="${GROK_HOME:-$REAL_HOME/.grok}"
NATIVE_HOME="${GROK_NATIVE_HOME:-$REAL_HOME/.grok-native-home}"

mkdir -p "$NATIVE_HOME"

export GROK_HOME="$GROK_STATE_HOME"
export HOME="$NATIVE_HOME"
export GROK_CLAUDE_SKILLS_ENABLED=false
export GROK_CLAUDE_RULES_ENABLED=false
export GROK_CLAUDE_AGENTS_ENABLED=false
export GROK_CLAUDE_MCPS_ENABLED=false
export GROK_CLAUDE_HOOKS_ENABLED=false
export GROK_CLAUDE_SESSIONS_ENABLED=false

exec grok "$@"
