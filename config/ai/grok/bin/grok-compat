#!/bin/bash
# Run Grok with the user's normal home and Claude compatibility enabled.

set -euo pipefail

export GROK_CLAUDE_SKILLS_ENABLED=true
export GROK_CLAUDE_RULES_ENABLED=true
export GROK_CLAUDE_AGENTS_ENABLED=true
export GROK_CLAUDE_MCPS_ENABLED=true
export GROK_CLAUDE_HOOKS_ENABLED=true
export GROK_CLAUDE_SESSIONS_ENABLED=true

exec grok "$@"
