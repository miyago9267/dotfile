{
  "agy-auto-update": {
    "PreInvocation": [
      {
        "command": "[ -f \"$HOME/.gemini/config/hooks/agy-auto-update.sh\" ] && bash \"$HOME/.gemini/config/hooks/agy-auto-update.sh\" || true",
        "timeout": 10,
        "type": "command"
      }
    ]
  },
  "herdr": {
    "PreInvocation": [
      {
        "command": "[ -f \"$HOME/.gemini/config/hooks/herdr-agent-state.sh\" ] && bash \"$HOME/.gemini/config/hooks/herdr-agent-state.sh\" session || true",
        "timeout": 10,
        "type": "command"
      }
    ]
  },
  "shoal-dispatch-guard": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "f=\"${XDG_DATA_HOME:-$HOME/.local/share}/shoal/guard/shoal_guard.py\"; [ -f \"$f\" ] || exit 0; exec python3 \"$f\" --host agy --event PreInvocation",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${XDG_DATA_HOME:-$HOME/.local/share}/shoal/guard/shoal_guard.py\"; [ -f \"$f\" ] || exit 0; exec python3 \"$f\" --host agy --event PreToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "type": "command",
        "command": "f=\"${XDG_DATA_HOME:-$HOME/.local/share}/shoal/guard/shoal_guard.py\"; [ -f \"$f\" ] || exit 0; exec python3 \"$f\" --host agy --event SessionStart",
        "timeout": 10
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "f=\"${XDG_DATA_HOME:-$HOME/.local/share}/shoal/guard/shoal_guard.py\"; [ -f \"$f\" ] || exit 0; exec python3 \"$f\" --host agy --event Stop",
        "timeout": 10
      }
    ]
  },
  "secret-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/dotfile/config/ai/shared/hooks/secret-guard-adapter.sh\" --host agy",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
