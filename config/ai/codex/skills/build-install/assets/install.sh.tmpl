#!/usr/bin/env bash
set -Eeuo pipefail

PROJECT_NAME=<PROJECT_NAME_SHELL>
REPOSITORY_URL=<REPOSITORY_URL_SHELL>
DEFAULT_REF=<DEFAULT_REF_SHELL>
INSTALL_DIR=<INSTALL_DIR_SHELL>
DRY_RUN=0
REF="$DEFAULT_REF"

usage() {
  printf 'Usage: %s [--ref REF] [--dry-run] [--help]\n' "$0"
}

while (($#)); do
  case "$1" in
    --ref) [[ $# -ge 2 ]] || { printf '%s\n' '--ref requires a value' >&2; exit 2; }; REF="$2"; shift 2 ;;
    --dry-run) DRY_RUN=1; shift ;;
    --help|-h) usage; exit 0 ;;
    *) printf 'Unknown option: %s\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
done

command -v git >/dev/null 2>&1 || { printf '%s\n' 'git is required' >&2; exit 1; }
command -v bash >/dev/null 2>&1 || { printf '%s\n' 'bash is required' >&2; exit 1; }

printf 'Installing %s (%s) into %s\n' "$PROJECT_NAME" "$REF" "$INSTALL_DIR"
if ((DRY_RUN)); then
  printf '%s\n' 'dry-run: no files will be changed'
  exit 0
fi

tmp_dir="$(mktemp -d)"
cleanup() { rm -rf -- "$tmp_dir"; }
trap cleanup EXIT

git clone --quiet --depth 1 --branch "$REF" "$REPOSITORY_URL" "$tmp_dir/source"
mkdir -p -- "$INSTALL_DIR"
if [[ -x "$tmp_dir/source/scripts/install-project.sh" ]]; then
  "$tmp_dir/source/scripts/install-project.sh" "$INSTALL_DIR"
else
  printf '%s\n' "No scripts/install-project.sh hook found; copy project-specific installation logic here." >&2
  exit 1
fi

printf 'Installed %s into %s\n' "$PROJECT_NAME" "$INSTALL_DIR"
