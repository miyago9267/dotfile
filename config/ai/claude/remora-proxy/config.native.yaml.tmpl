host: "127.0.0.1"
port: 8317
remote-management:
  allow-remote: false
  secret-key: "__MGMT_SECRET_KEY__"
  disable-control-panel: false
auth-dir: "__PROXY_DIR__/auths"
api-keys:
  - "__PROXY_API_KEY__"
debug: false
logging-to-file: false
usage-statistics-enabled: false
request-retry: 2
max-retry-interval: 8
disable-cooling: true
save-cooldown-status: false

openai-compatibility:
  - name: "aluo"
    base-url: "https://ai-api.aluo.work/v1"
    api-key-entries:
      - api-key: "__ALUO_API_KEY__"
    models:
      - name: "gpt-5.6-sol"
        alias: "gpt-5.6-sol"
      - name: "gpt-5.6-terra"
        alias: "gpt-5.6-terra"
      - name: "gpt-5.6-luna"
        alias: "gpt-5.6-luna"
