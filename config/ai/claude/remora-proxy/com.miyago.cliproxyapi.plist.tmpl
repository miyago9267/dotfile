<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.miyago.cliproxyapi</string>
    <key>ProgramArguments</key>
    <array>
        <string>__PROXY_DIR__/bin/cli-proxy-api</string>
        <string>-config</string>
        <string>__PROXY_DIR__/config.native.yaml</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__PROXY_DIR__</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__PROXY_DIR__/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>__PROXY_DIR__/logs/launchd.err.log</string>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
