{
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "100",
    "CLAUDE_CODE_THISTLE_GREBE": "counter_steer",
    "CLAUDE_CODE_DISABLE_GIT_INSTRUCTIONS": "1",
    "STINGRAY": "1",
    "STINGRAY_SHAPE3": "1"
  },
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "Glob(*)",
      "Grep(*)",
      "WebSearch(*)",
      "WebFetch(*)",
      "mcp__claude_ai_Canva__generate-design",
      "mcp__claude_ai_Canva__create-design-from-candidate",
      "mcp__claude_ai_Canva__export-design",
      "Bash(echo \"deleted: $?\")",
      "Bash(/bin/ls -1)",
      "Bash(/bin/ls -1 line_bot_updated/)",
      "mcp__reticle",
      "Bash(agy -p:*)"
    ],
    "deny": [
      "Bash(mkfs *)",
      "Bash(dd *)",
      "Bash(shutdown *)",
      "Bash(reboot *)",
      "Bash(sudo rm *)",
      "Bash(sudo dd *)",
      "Bash(chmod -R 777 *)",
      "Read(~/dotfile/secrets/**)",
      "Read(~/.ssh/**)",
      "Read(~/.kube/config)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.age/**)",
      "Read(~/.env.secrets)",
      "Read(~/.config/sops/age/**)",
      "Read(~/Library/Application Support/sops/age/**)",
      "Read(~/Library/Keychains/**)",
      "Read(//**/.env)",
      "Read(//**/.env.local)",
      "Read(//**/.env.*.local)",
      "Read(//**/.env.production)",
      "Read(//**/.env.development)",
      "Read(//**/.env.staging)",
      "Read(//**/.env.test)"
    ],
    "ask": [
      "Bash(git push --force*)",
      "Bash(git push -f *)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
      "~/.claude",
      "~/Project/Code/ITRD/pms/.claude",
      "~/Project/Note/sre-knowledge-base",
      "~/Project/Note/itrd-knowledge-base"
    ]
  },
  "model": "opus[1m]",
  "fallbackModel": [
    "sonnet"
  ],
  "hooks": {
    "InstructionsLoaded": [
      {
        "matcher": "session_start|include|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/dotfile/config/ai/claude/hooks/instructions-loaded-reminder.sh",
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/dotfile/config/ai/claude/hooks/pre-bash.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/dotfile/config/ai/claude/hooks/read-guard.sh",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/dotfile/config/ai/claude/hooks/suggest-compact.sh",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/dotfile/config/ai/claude/hooks/jev-compaction-shadow.sh",
            "timeout": 3
          }
        ]
      }
    ],
    "CwdChanged": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/dotfile/config/ai/claude/hooks/cwd-context.sh",
            "timeout": 3
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/dotfile/config/ai/claude/hooks/prompt-submit.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/dotfile/config/ai/claude/hooks/pre-compact-instructions.sh",
            "timeout": 3
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/dotfile/config/ai/claude/hooks/post-compact-reminder.sh",
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/post-tool-use-format.sh",
            "timeout": 30,
            "statusMessage": "Auto format & lint..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/dotfile/config/ai/claude/hooks/git-push-ci-reminder.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/dotfile/config/ai/claude/hooks/subagent-stop-reminder.sh",
            "timeout": 3
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/dotfile/config/ai/claude/hooks/task-completed-reminder.sh",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/dotfile/config/ai/claude/hooks/persona-reminder.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ~/dotfile/config/ai/claude/hooks/sre-inventory-stale-check.sh",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "bash ~/dotfile/config/ai/claude/hooks/daily-interview-reminder.sh",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "bash ~/dotfile/config/ai/claude/hooks/agent-stack-auto-update.sh",
            "async": true
          }
        ]
      },
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$HOME/.claude/hooks/herdr-agent-state.sh\" ] && bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session || true",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/dotfile/config/ai/claude/hooks/zh-tw-guard.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 ~/dotfile/config/ai/claude/hooks/goal-handoff-guard.py",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/dotfile/config/ai/claude/hooks/jev-context-shadow.sh",
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/dotfile/config/ai/claude/hooks/path-hint.sh",
            "timeout": 3
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/coralline/statusline.sh",
    "refreshInterval": 10
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "bash ~/.claude/coralline/statusline.sh --subagent"
  },
  "enabledPlugins": {
    "gitlab@claude-plugins-official": true,
    "sentry@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": false,
    "learning-output-style@claude-plugins-official": false,
    "plugin-dev@claude-plugins-official": false,
    "swift-lsp@claude-plugins-official": true,
    "claude-hud@claude-hud": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true,
    "i-have-adhd@i-have-adhd": true,
    "stingray@stingray": true,
    "warp@claude-code-warp": true,
    "shoal@shoal": true,
    "taste-skill@taste-skill": true,
    "shoal-dispatch-guard@shoal": true,
    "baton@baton": true
  },
  "extraKnownMarketplaces": {
    "claude-hud": {
      "source": {
        "source": "github",
        "repo": "jarrodwatts/claude-hud"
      }
    },
    "i-have-adhd": {
      "source": {
        "source": "github",
        "repo": "ayghri/i-have-adhd"
      }
    },
    "stingray": {
      "source": {
        "source": "github",
        "repo": "Nanako0129/stingray"
      }
    },
    "claude-code-warp": {
      "source": {
        "source": "github",
        "repo": "warpdotdev/claude-code-warp"
      }
    },
    "shoal": {
      "source": {
        "source": "directory",
        "path": "~/.local/share/shoal/claude-marketplace"
      }
    },
    "taste-skill": {
      "source": {
        "source": "github",
        "repo": "Leonxlnx/taste-skill"
      }
    },
    "baton": {
      "source": {
        "source": "directory",
        "path": "~/Project/Active/baton"
      }
    }
  },
  "effortLevel": "medium",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "pluginConfigs": {
    "agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md-and-agents-md"
      }
    }
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark-ansi",
  "agentPushNotifEnabled": true,
  "feedbackDrafts": "off"
}
