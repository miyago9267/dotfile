{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6",
  "small_model": "openai/gpt-5.6-luna",
  "default_agent": "monika",
  "subagent_depth": 1,
  "share": "disabled",
  "enabled_providers": [
    "openai",
    "chatgpt-proxy",
    "deepseek",
    "google",
    "github-copilot",
    "xai",
    "grok-cli",
    "opencode",
    "aluo"
  ],
  "provider": {
    "openai": {
      "models": {
        "gpt-5.6": {
          "name": "GPT-5.6"
        },
        "gpt-5.6-sol": {
          "name": "GPT-5.6 Sol"
        },
        "gpt-5.6-terra": {
          "name": "GPT-5.6 Terra"
        },
        "gpt-5.6-luna": {
          "name": "GPT-5.6 Luna"
        }
      }
    },
    "chatgpt-proxy": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "ChatGPT Pro local proxy",
      "options": {
        "baseURL": "{file:~/.config/opencode/secrets/chatgpt-proxy-base-url}",
        "apiKey": "{file:~/.config/opencode/secrets/chatgpt-proxy-api-key}"
      },
      "models": {
        "gpt-5.6": {
          "name": "GPT-5.6 (ChatGPT Pro proxy)"
        },
        "gpt-5.6-sol": {
          "name": "GPT-5.6 Sol (ChatGPT Pro proxy)"
        },
        "gpt-5.6-terra": {
          "name": "GPT-5.6 Terra (ChatGPT Pro proxy)"
        },
        "gpt-5.6-luna": {
          "name": "GPT-5.6 Luna (ChatGPT Pro proxy)"
        }
      }
    },
    "google": {
      "options": {
        "apiKey": "{file:~/.config/opencode/secrets/gemini-api-key}"
      },
      "models": {
        "gemini-3-pro-preview": {
          "name": "Gemini 3 Pro Preview"
        },
        "gemini-2.5-pro": {
          "name": "Gemini 2.5 Pro"
        },
        "gemini-2.5-flash": {
          "name": "Gemini 2.5 Flash"
        },
        "gemini-2.0-flash": {
          "name": "Gemini 2.0 Flash"
        }
      }
    },
    "aluo": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Aluo API",
      "options": {
        "baseURL": "https://ai-api.aluo.work/v1",
        "apiKey": "{file:~/.config/opencode/secrets/aluo-api-key}"
      },
      "models": {
        "gpt-5.5": {
          "name": "GPT-5.5 (Aluo bridge)"
        },
        "gpt-5.4": {
          "name": "GPT-5.4 (Aluo bridge)"
        },
        "gpt-5.6": {
          "name": "GPT-5.6 (Aluo bridge)"
        },
        "gpt-5.6-sol": {
          "name": "GPT-5.6 Sol (Aluo bridge)"
        },
        "gpt-5.6-terra": {
          "name": "GPT-5.6 Terra (Aluo bridge)"
        },
        "gpt-5.6-luna": {
          "name": "GPT-5.6 Luna (Aluo bridge)"
        }
      }
    },
    "xai": {
      "models": {
        "grok-4.5": {
          "name": "Grok 4.5"
        },
        "grok-4": {
          "name": "Grok 4"
        },
        "grok-4-fast-reasoning": {
          "name": "Grok 4 Fast Reasoning"
        },
        "grok-4-fast-non-reasoning": {
          "name": "Grok 4 Fast Non-Reasoning"
        },
        "grok-code-fast-1": {
          "name": "Grok Code Fast 1"
        }
      }
    },
    "grok-cli": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "SuperGrok local CLI proxy",
      "options": {
        "baseURL": "{file:~/.config/opencode/secrets/grok-cli-base-url}",
        "apiKey": "{file:~/.config/opencode/secrets/grok-cli-api-key}"
      },
      "models": {
        "grok-4": {
          "name": "Grok 4 (SuperGrok CLI proxy)"
        },
        "grok-4-fast-reasoning": {
          "name": "Grok 4 Fast Reasoning (SuperGrok CLI proxy)"
        },
        "grok-4-fast-non-reasoning": {
          "name": "Grok 4 Fast Non-Reasoning (SuperGrok CLI proxy)"
        },
        "grok-code-fast-1": {
          "name": "Grok Code Fast 1 (SuperGrok CLI proxy)"
        }
      }
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 40000
  },
  "watcher": {
    "ignore": [
      ".git/**",
      ".direnv/**",
      ".venv/**",
      "node_modules/**",
      "dist/**",
      "build/**",
      "coverage/**",
      ".turbo/**",
      ".next/**",
      ".nuxt/**",
      ".cache/**",
      "tmp/**",
      "temp/**",
      "logs/**",
      "*.log",
      "secrets/**",
      "**/.obsidian/**",
      "**/.trash/**",
      "**/.DS_Store"
    ]
  },
  "instructions": [
    "~/.config/miyago-agent/AGENTS.md",
    "~/.config/miyago-agent/personal-model/PROFILE.md",
    "AGENTS.md"
  ],
  "permission": {
    "task": "ask",
    "skill": {
      "safe-ops": "allow",
      "git-workflow": "allow",
      "no-ai-attribution": "allow",
      "search-discipline": "allow",
      "path-aware": "allow",
      "efficiency": "allow",
      "markdown-lint": "allow",
      "tdd": "allow",
      "ask-tty": "deny",
      "auto-docs": "deny",
      "cicd-watch": "deny",
      "strategic-compact": "deny",
      "*": "deny"
    }
  }
}
