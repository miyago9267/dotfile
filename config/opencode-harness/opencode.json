{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-luna",
  "default_agent": "monika-large",
  "instructions": [
    "~/.config/miyago-agent/AGENTS.md"
    ,"~/.config/miyago-agent/personal-model/PROFILE.md"
  ],
  "plugin": [
    "oh-my-openagent@latest",
    "file:///Users/miyago/dotfile/config/opencode-harness/plugins/pilotfish-opencode.js"
  ],
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "enabled": true,
      "timeout": 10000
    },
    "pty-bridge": {
      "type": "local",
      "command": [
        "/Users/miyago/.bun/bin/bun",
        "run",
        "/Users/miyago/dotfile/config/ai/claude/mcp/pty-bridge/index.ts"
      ],
      "enabled": false
    },
    "sentry:sentry": {
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp",
      "enabled": false
    }
  }
}
